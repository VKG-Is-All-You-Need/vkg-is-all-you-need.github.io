---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../data/site';

const toc = [
  { id: 'scope', label: '收录与核对' },
  { id: 'contribute', label: '参与贡献' },
  { id: 'credits', label: '来源与致谢' },
  { id: 'tech', label: '技术实现' },
];
---

<BaseLayout
  title="关于本站"
  description="VKG is all you need 的收录范围、核对方式、贡献流程与来源说明。"
>
  <PageHeader
    label="关于本站"
    title="面向中文读者的 VKG 资源索引"
    description="VKG is all you need 由 VKG-Is-All-You-Need 组织维护，收录与虚拟知识图谱和 OBDA 相关的标准规范、工具、教程、基准测试与论文，并为每项资源注明适用范围与使用限制。"
  />

  <div class="container layout">
    <nav class="toc" aria-label="本页目录">
      <p>本页目录</p>
      <ul role="list">
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="prose">
      <section id="scope" data-reveal>
        <h2>收录与核对</h2>
        <dl class="facts">
          <div>
            <dt>收录范围</dt>
            <dd>
              与 VKG/OBDA 直接相关的标准、工具、教程、基准与研究，以及映射工程相关的周边生态。
            </dd>
          </div>
          <div>
            <dt>核对方式</dt>
            <dd>
              资源信息与{' '}
              <a class="text-link" href={site.links.resources}>
                vkg-resources
              </a>{' '}
              仓库同步，最近核对于 <time datetime={site.verifiedAt}>{site.verifiedAt}</time>
              。核对范围限于项目页面与文档，未经安装或运行验证；使用前请确认版本、数据与许可证。
            </dd>
          </div>
          <div>
            <dt>独立性</dt>
            <dd>所列外部项目均由其作者独立维护，本组织不代表上述项目。</dd>
          </div>
        </dl>
      </section>

      <section id="contribute" data-reveal>
        <h2>参与贡献</h2>
        <ol class="steps" role="list">
          <li>
            <h3>报告问题</h3>
            <p>
              链接失效、描述有误或信息过时，请在{' '}
              <a class="text-link" href={site.links.issues}>
                vkg-resources
              </a>{' '}
              提交 issue。
            </p>
          </li>
          <li>
            <h3>推荐资源</h3>
            <p>在 issue 中提供名称、链接、所属类别、一句话简介与已知限制。</p>
          </li>
          <li>
            <h3>直接修改</h3>
            <p>
              资源数据位于站点仓库的 <code>src/data/resources.yaml</code>，可直接提交 pull
              request。构建时会按 schema 校验字段，校验失败的修改无法合并。
            </p>
          </li>
        </ol>
        <div class="actions">
          <a class="btn btn-primary" href={site.links.issues}>
            提交 issue <Icon name="arrow-right" />
          </a>
          <a class="btn" href={site.links.repo}>
            <Icon name="github" /> 站点仓库
          </a>
        </div>
      </section>

      <section id="credits" data-reveal>
        <h2>来源与致谢</h2>
        <ul class="list" role="list">
          <li>
            内容来源：
            <a class="text-link" href={site.links.resources}>
              vkg-resources
            </a>{' '}
            资源指南，最初整理自{' '}
            <a class="text-link" href="https://blog.homura.work/posts/study/paper/vkg/">
              VKG 学习笔记
            </a>
            。
          </li>
          <li>
            视觉标识：VKG 标志取自组织主页横幅，见{' '}
            <a class="text-link" href={site.links.profile}>
              .github
            </a>{' '}
            仓库。
          </li>
          <li>
            版式参考：早期版本参考了 HTML5 UP 的{' '}
            <a class="text-link" href="https://html5up.net/editorial">
              Editorial
            </a>
            （
            <a class="text-link" href="https://html5up.net/license">
              CC BY 3.0
            </a>
            ）。
          </li>
          <li>外部论文、数据集与软件的版权归原作者所有，本站仅提供链接。</li>
        </ul>
      </section>

      <section id="tech" data-reveal>
        <h2>技术实现</h2>
        <p>
          本站使用{' '}
          <a class="text-link" href="https://astro.build/">
            Astro
          </a>{' '}
          构建为纯静态页面。资源数据以 YAML 维护，构建时按 schema 校验；通过 GitHub Actions
          自动部署至 GitHub Pages，也可部署至 Cloudflare。地理信息示例的三维场景使用 three.js
          渲染，仅在该页面按需加载。站点不使用 Cookie、统计脚本或第三方 CDN。
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 64px;
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }

  .toc p {
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--faint);
  }

  .toc ul {
    display: grid;
    gap: 2px;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 6px 14px;
    border-left: 1px solid transparent;
    font-size: 14px;
    color: var(--muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  .prose {
    display: grid;
    gap: 64px;
    max-width: 760px;
  }

  .prose section {
    scroll-margin-top: calc(var(--header-h) + 32px);
  }

  h2 {
    margin-bottom: 24px;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .prose p,
  .prose dd,
  .prose li {
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 8px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-weight: 600;
  }

  .steps {
    display: grid;
    gap: 12px;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 20px 22px 20px 64px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 20px;
    top: 20px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    font: 600 13px var(--font-mono);
    color: var(--accent-ink);
  }

  .steps h3 {
    font-size: 17px;
    font-weight: 650;
  }

  .steps p {
    margin-top: 4px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .list {
    display: grid;
    gap: 12px;
  }

  .list li {
    position: relative;
    padding-left: 20px;
  }

  .list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .facts > div {
      grid-template-columns: 1fr;
    }
  }
</style>
