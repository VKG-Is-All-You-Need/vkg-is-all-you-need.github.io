---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import Constellation from '../../components/papers/Constellation.astro';
import { paperTopics, repoGroups } from '../../data/papers';
import { buildContext, LAYOUTS } from '../../lib/constellation';
import { langOf, langPaths } from '../../i18n';
import { getPapers, getRepos, paperSummary, shortTitle } from '../../lib/papers';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url.pathname);
const papers = await getPapers();
const repos = await getRepos();
const withCode = papers.filter((paper) => paper.data.code).length;
const topics = paperTopics(lang).map((topic) => ({
  ...topic,
  items: papers.filter((paper) => paper.data.topic === topic.id),
}));
const groups = repoGroups(lang).map((group) => ({
  ...group,
  items: repos.filter((repo) => repo.data.group === group.id),
}));
const paperById = new Map(papers.map((paper) => [paper.id, paper]));
const relationCount = buildContext(papers, repos, lang).links.length;

const t = {
  zh: {
    title: '文献',
    meta: `VKG 与 OBDA 方向的 ${papers.length} 篇讲义与论文、${repos.length} 个代码仓库，按主题排列。`,
    heading: '论文与代码仓库',
    description: `VKG 与 OBDA 方向的讲义、论文与开源仓库，按主题排列：共 ${papers.length} 篇论文，其中 ${withCode} 篇附有代码，另有 ${repos.length} 个仓库。`,
    search: '搜索论文与仓库',
    placeholder: '搜索标题、作者、会议或主题',
    codeOnly: '只看有代码',
    sections: '本页分区',
    repos: '代码仓库',
    reposDescription: 'VKG 系统、教程案例、基准与论文实现的公开仓库。',
    paper: '论文',
    code: '代码',
    relatedPaper: '论文：',
    count: (n: number) => `${n} 篇论文`,
    view: '显示模式',
    standard: '标准',
    fx: '炫酷',
    hintTitle: '文献星图',
    hintText: `炫酷模式以星图展示 ${papers.length} 篇论文的年份、主题与 ${relationCount} 条传承和引用关系，提供 ${LAYOUTS.length} 种布局。`,
    hintOpen: '查看',
    hintClose: '不再提示',
    empty: '无匹配结果。请尝试更短的关键词，或关闭“只看有代码”。',
  },
  en: {
    title: 'Papers',
    meta: `${papers.length} lectures and papers and ${repos.length} code repositories on VKG and OBDA, arranged by topic.`,
    heading: 'Papers and repositories',
    description: `Lectures, papers and open-source repositories on VKG and OBDA, arranged by topic: ${papers.length} papers, ${withCode} of them with code, and ${repos.length} repositories.`,
    search: 'Search papers and repositories',
    placeholder: 'Search by title, author, venue or topic',
    codeOnly: 'With code only',
    sections: 'Sections',
    repos: 'Repositories',
    reposDescription:
      'Public repositories of VKG systems, tutorials and case studies, benchmarks and paper implementations.',
    paper: 'Paper',
    code: 'Code',
    relatedPaper: 'Paper: ',
    count: (n: number) => `${n} papers`,
    view: 'Display mode',
    standard: 'Standard',
    fx: 'Fancy',
    hintTitle: 'Paper constellation',
    hintText: `The fancy view draws the ${papers.length} papers as a star map of years, topics and ${relationCount} lineage and citation links, with ${LAYOUTS.length} layouts.`,
    hintOpen: 'Show me',
    hintClose: 'Dismiss',
    empty: 'No matches. Try a shorter keyword or turn off "With code only".',
  },
}[lang];
---

<BaseLayout title={t.title} description={t.meta}>
  <div class="papers-page" data-papers-page>
    <!-- 在首次绘制前按本地记录切换到动效模式，避免页面跳动 -->
    <script is:inline>
      try {
        if (localStorage.getItem('papers-view') === 'fx') {
          document.currentScript.parentElement.setAttribute('data-fx', '');
        }
      } catch {}
    </script>
    <PageHeader label={t.title} title={t.heading} description={t.description} />

    <div class="container fx-only">
      <Constellation />
    </div>

    <div class="container page-body" data-papers>
      <div class="toolbar">
        <label class="search">
          <Icon name="search" size={16} />
          <span class="visually-hidden">{t.search}</span>
          <input
            type="search"
            placeholder={t.placeholder}
            autocomplete="off"
            spellcheck="false"
            data-papers-search
          />
        </label>
        <button type="button" class="code-toggle" aria-pressed="false" data-papers-code>
          <Icon name="github" size={14} />
          {t.codeOnly}
        </button>
        <p class="count" role="status" aria-live="polite" data-papers-count>
          {t.count(papers.length)}
        </p>
        <div class="view-wrap">
          <div class="view-switch" role="group" aria-label={t.view}>
            <button type="button" data-papers-view="standard" aria-pressed="true">
              {t.standard}
            </button>
            <button type="button" data-papers-view="fx" aria-pressed="false">
              <Icon name="sparkles" size={14} />
              {t.fx}
            </button>
          </div>
          <!-- 首次访问时介绍动效模式，只出现一次 -->
          <div class="fx-hint" role="note" data-fx-hint hidden>
            <svg class="fx-hint-art" viewBox="0 0 64 40" aria-hidden="true">
              <path d="M8 30 22 12 36 22 50 8 58 26" />
              <circle cx="8" cy="30" r="2.2" />
              <circle cx="22" cy="12" r="3" />
              <circle cx="36" cy="22" r="2.4" />
              <circle cx="50" cy="8" r="2.8" />
              <circle cx="58" cy="26" r="2" />
            </svg>
            <p class="fx-hint-title">{t.hintTitle}</p>
            <p class="fx-hint-text">{t.hintText}</p>
            <div class="fx-hint-actions">
              <button type="button" class="fx-hint-open" data-fx-hint-open>
                <Icon name="sparkles" size={13} />
                {t.hintOpen}
              </button>
              <button type="button" class="fx-hint-close" data-fx-hint-close>
                {t.hintClose}
              </button>
            </div>
          </div>
        </div>
        <nav class="jump" aria-label={t.sections}>
          {topics.map((topic) => (
            <a href={`#${topic.id}`}>
              {topic.label}
              <span>{topic.items.length}</span>
            </a>
          ))}
          <a href="#repos">
            {t.repos}
            <span>{repos.length}</span>
          </a>
        </nav>
      </div>

      {topics.map((topic) => (
        <section class="topic" id={topic.id} data-topic aria-labelledby={`${topic.id}-title`}>
          <header class="topic-head">
            <h2 id={`${topic.id}-title`}>
              {topic.label}
              <span>{topic.items.length}</span>
            </h2>
            <p>{topic.description}</p>
          </header>
          <ol class="papers" role="list">
            {topic.items.map((paper) => (
              <li
                class="paper"
                id={paper.id}
                data-paper
                data-code={paper.data.code ? '' : undefined}
              >
                <span class="paper-year">{paper.data.year}</span>
                <div class="paper-body">
                  <h3>
                    <a href={paper.data.url} target="_blank" rel="noopener">
                      {paper.data.title}
                    </a>
                  </h3>
                  <p class="paper-meta">
                    {paper.data.authors} · <em>{paper.data.venue}</em>
                  </p>
                  <p class="paper-summary">{paperSummary(paper, lang)}</p>
                </div>
                <div class="paper-links">
                  <a href={paper.data.url} target="_blank" rel="noopener">
                    {t.paper}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                  {paper.data.code && (
                    <a class="is-code" href={paper.data.code} target="_blank" rel="noopener">
                      <Icon name="github" size={12} />
                      {t.code}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <p class="empty" data-papers-empty hidden>
        {t.empty}
      </p>

      <section class="topic" id="repos" data-topic aria-labelledby="repos-title">
        <header class="topic-head">
          <h2 id="repos-title">
            {t.repos}
            <span>{repos.length}</span>
          </h2>
          <p>{t.reposDescription}</p>
        </header>
        {groups.map((group) => (
          <div class="repo-group" data-repo-group>
            <h3 class="repo-group-title">{group.label}</h3>
            <ul class="repos" role="list">
              {group.items.map((repo) => {
                const paper = repo.data.paper ? paperById.get(repo.data.paper) : undefined;
                return (
                  <li class="repo" data-repo>
                    <a
                      class="repo-name"
                      href={`https://github.com/${repo.data.repo}`}
                      target="_blank"
                      rel="noopener"
                    >
                      <Icon name="github" size={14} />
                      <span>{repo.data.repo}</span>
                    </a>
                    <p class="repo-summary">{paperSummary(repo, lang)}</p>
                    {paper && (
                      <a class="repo-paper" href={`#${paper.id}`}>
                        {t.relatedPaper}
                        {shortTitle(paper.data.title)}
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* 显示模式：动效模式下显示星图 */
  .fx-only {
    display: none;
  }

  .papers-page[data-fx] .fx-only {
    display: block;
    margin-bottom: 28px;
  }

  .fx-only :global([data-constellation]) {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .papers-page[data-fx] :global(.page-header) {
    padding-bottom: clamp(28px, 4vw, 40px);
  }

  .papers-page[data-fx] :global(.page-header .backdrop)::after {
    animation: aurora 14s ease-in-out infinite alternate;
  }

  @keyframes aurora {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.35;
    }
    50% {
      transform: translate3d(-18%, 10%, 0) scale(1.15);
      opacity: 0.55;
    }
    100% {
      transform: translate3d(-36%, 0, 0) scale(0.95);
      opacity: 0.4;
    }
  }

  /* 首次访问的引导：炫酷按钮的流光边框与下方的介绍卡片 */
  .view-wrap {
    position: relative;
  }

  .view-switch button[data-papers-view='fx'] {
    position: relative;
    isolation: isolate;
  }

  .view-switch button.is-inviting {
    color: var(--ink);
  }

  .view-switch button.is-inviting::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--spin, 0deg), #2a6fdb, #49bbdd, #8f6bff, #f29fb8, #2a6fdb);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: invite-spin 3s linear infinite;
  }

  .view-switch button.is-inviting::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgb(73 187 221 / 0.55);
    animation: invite-pulse 2.4s ease-out infinite;
  }

  @property --spin {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes invite-spin {
    to {
      --spin: 360deg;
    }
  }

  @keyframes invite-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(73 187 221 / 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px rgb(73 187 221 / 0);
    }
  }

  .fx-hint {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: 30;
    width: min(300px, calc(100vw - 32px));
    padding: 14px 16px 14px;
    border-radius: 14px;
    border: 1px solid rgb(120 170 230 / 0.3);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(73 140 221 / 0.28), transparent 60%),
      radial-gradient(90% 80% at 0% 100%, rgb(170 110 240 / 0.2), transparent 60%), #070b14;
    color: #e9eef5;
    box-shadow:
      0 24px 60px -24px rgb(10 30 60 / 0.7),
      0 0 40px -12px rgb(73 187 221 / 0.5);
    animation: hint-in 0.45s var(--ease);
  }

  .fx-hint[hidden] {
    display: none;
  }

  /* 指向炫酷按钮的小三角 */
  .fx-hint::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 34px;
    width: 10px;
    height: 10px;
    border-top: 1px solid rgb(120 170 230 / 0.3);
    border-left: 1px solid rgb(120 170 230 / 0.3);
    background: #0b1424;
    transform: rotate(45deg);
  }

  @keyframes hint-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }

  .fx-hint-art {
    display: block;
    width: 64px;
    height: 40px;
    margin-bottom: 6px;
  }

  .fx-hint-art path {
    fill: none;
    stroke: rgb(191 234 255 / 0.5);
    stroke-width: 1;
    stroke-dasharray: 90;
    stroke-dashoffset: 90;
    animation: hint-draw 1.4s var(--ease) 0.2s forwards;
  }

  .fx-hint-art circle {
    fill: #7fd3ec;
    filter: drop-shadow(0 0 3px #7fd3ec);
    animation: hint-twinkle 2.2s ease-in-out infinite alternate;
  }

  .fx-hint-art circle:nth-of-type(2) {
    fill: #f5d77a;
    animation-delay: 0.4s;
  }

  .fx-hint-art circle:nth-of-type(4) {
    fill: #c99bff;
    animation-delay: 0.8s;
  }

  @keyframes hint-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hint-twinkle {
    to {
      opacity: 0.45;
    }
  }

  .fx-hint-title {
    font-size: 14px;
    font-weight: 700;
  }

  .fx-hint-text {
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.65;
    color: #b9c2cd;
  }

  .fx-hint-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .fx-hint-open {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: linear-gradient(120deg, #2a6fdb, #49bbdd 55%, #8f6bff);
    font-size: 12.5px;
    color: #fff;
    box-shadow: 0 0 16px -4px rgb(73 187 221 / 0.8);
    transition: filter 0.2s;
  }

  .fx-hint-open:hover {
    filter: brightness(1.12);
  }

  .fx-hint-close {
    font-size: 12px;
    color: #7f8a97;
    transition: color 0.2s;
  }

  .fx-hint-close:hover {
    color: #e9eef5;
  }

  @media (prefers-reduced-motion: reduce) {
    .view-switch button.is-inviting::before,
    .view-switch button.is-inviting::after,
    .fx-hint,
    .fx-hint-art path,
    .fx-hint-art circle {
      animation: none;
    }

    .fx-hint-art path {
      stroke-dashoffset: 0;
    }
  }

  .view-switch {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .view-switch button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
    transition:
      color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }

  .view-switch button:hover {
    color: var(--ink);
  }

  .view-switch button[aria-pressed='true'] {
    background: var(--surface-2);
    color: var(--ink);
  }

  .view-switch button[data-papers-view='fx'][aria-pressed='true'] {
    background: linear-gradient(120deg, #2a6fdb, #49bbdd 55%, #8f6bff);
    color: #fff;
    box-shadow: 0 0 18px -4px rgb(73 187 221 / 0.8);
  }

  /* 工具栏 */
  .toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding-block: 14px 10px;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 320px;
    height: 38px;
    padding: 0 12px 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--faint);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 14px;
    color: var(--ink);
  }

  .search input::placeholder {
    color: var(--faint);
  }

  .code-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .code-toggle:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .code-toggle[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .count {
    margin-left: auto;
    font: 13px var(--font-mono);
    color: var(--faint);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    width: 100%;
    font-size: 13px;
  }

  .jump a {
    color: var(--muted);
    transition: color 0.2s;
  }

  .jump a:hover {
    color: var(--accent-ink);
  }

  .jump span {
    margin-left: 4px;
    font: 11px var(--font-mono);
    color: var(--faint);
  }

  /* 主题分区 */
  .topic {
    padding-top: 48px;
    scroll-margin-top: calc(var(--header-h) + 96px);
  }

  .topic-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 4px 40px;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }

  .topic-head h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .topic-head h2 span {
    font: 500 13px var(--font-mono);
    color: var(--faint);
  }

  .topic-head p {
    font-size: 14px;
    color: var(--muted);
  }

  /* 论文条目 */
  .paper {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: 4px 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 110px);
  }

  .paper:target {
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
  }

  .paper-year {
    padding-top: 2px;
    font: 500 13px var(--font-mono);
    color: var(--faint);
  }

  .paper h3 {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.005em;
  }

  .paper h3 a {
    transition: color 0.2s;
  }

  .paper h3 a:hover {
    color: var(--accent-ink);
  }

  .paper-meta {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--faint);
  }

  .paper-meta em {
    font-style: normal;
    color: var(--muted);
  }

  .paper-summary {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }

  .paper-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    padding-top: 2px;
  }

  .paper-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 12px;
    white-space: nowrap;
    color: var(--muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .paper-links a:hover {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .paper-links a.is-code {
    color: var(--ink-2);
  }

  .empty {
    padding: 64px 0;
    text-align: center;
    color: var(--muted);
  }

  /* 仓库 */
  .repo-group {
    padding-top: 20px;
  }

  .repo-group-title {
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--faint);
  }

  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 10px;
  }

  .repo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .repo-name {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    font: 500 13.5px var(--font-mono);
    color: var(--ink);
    transition: color 0.2s;
  }

  .repo-name span {
    overflow: hidden;
    text-overflow: ellipsis;
