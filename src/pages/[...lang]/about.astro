---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../data/site';
import { langOf, langPaths } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url.pathname);
const t = {
  zh: {
    title: '关于本站',
    meta: 'VKG is all you need 的收录范围、核对方式、贡献流程与来源说明。',
    heading: 'VKG 与 OBDA 资源索引',
    description:
      'VKG is all you need 由 VKG-Is-All-You-Need 组织维护，收录与虚拟知识图谱和 OBDA 相关的标准规范、工具、教程、基准测试与论文，并为每项资源注明适用范围与使用限制。',
    toc: '本页目录',
    sections: ['收录与核对', '参与贡献', '来源与致谢', '技术实现'],
  },
  en: {
    title: 'About',
    meta: 'Scope, verification, contribution process and sources of VKG is all you need.',
    heading: 'A resource index for VKG and OBDA',
    description:
      'VKG is all you need is maintained by the VKG-Is-All-You-Need organization. It lists standards, tools, tutorials, benchmarks and papers on virtual knowledge graphs and OBDA, and notes the scope and limitations of each resource.',
    toc: 'On this page',
    sections: ['Scope and verification', 'Contributing', 'Sources and credits', 'Implementation'],
  },
}[lang];

const toc = ['scope', 'contribute', 'credits', 'tech'].map((id, i) => ({
  id,
  label: t.sections[i],
}));
---

<BaseLayout title={t.title} description={t.meta}>
  <PageHeader label={t.title} title={t.heading} description={t.description} />

  <div class="container layout">
    <nav class="toc" aria-label={t.toc}>
      <p>{t.toc}</p>
      <ul role="list">
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    {lang === 'zh' ? (
      <article class="prose">
        <section id="scope" data-reveal>
          <h2>收录与核对</h2>
          <dl class="facts">
            <div>
              <dt>收录范围</dt>
              <dd>
                与 VKG/OBDA 直接相关的标准、工具、教程、基准与研究，以及映射工程相关的周边生态。
              </dd>
            </div>
            <div>
              <dt>核对方式</dt>
              <dd>
                资源信息与{' '}
                <a class="text-link" href={site.links.resources}>
                  vkg-resources
                </a>{' '}
                仓库同步，最近核对于 <time datetime={site.verifiedAt}>{site.verifiedAt}</time>
                。核对范围限于项目页面与文档，未经安装或运行验证；使用前请确认版本、数据与许可证。
              </dd>
            </div>
            <div>
              <dt>独立性</dt>
              <dd>所列外部项目均由其作者独立维护，本组织不代表上述项目。</dd>
            </div>
            <div>
              <dt>语言</dt>
              <dd>站点提供中文与英文两个版本，资源简介与交互示例同时以两种语言维护。</dd>
            </div>
          </dl>
        </section>

        <section id="contribute" data-reveal>
          <h2>参与贡献</h2>
          <ol class="steps" role="list">
            <li>
              <h3>报告问题</h3>
              <p>
                链接失效、描述有误或信息过时，请在{' '}
                <a class="text-link" href={site.links.issues}>
                  vkg-resources
                </a>{' '}
                提交 issue。
              </p>
            </li>
            <li>
              <h3>推荐资源</h3>
              <p>在 issue 中提供名称、链接、所属类别、一句话简介与已知限制。</p>
            </li>
            <li>
              <h3>直接修改</h3>
              <p>
                资源数据位于站点仓库的 <code>src/data/resources.yaml</code>，可直接提交 pull
                request。每项资源包含中文与英文简介（<code>summary</code> 与 <code>summary_en</code>
                ）。构建时会按 schema 校验字段，校验失败的修改无法合并。
              </p>
            </li>
          </ol>
          <div class="actions">
            <a class="btn btn-primary" href={site.links.issues}>
              提交 issue <Icon name="arrow-right" />
            </a>
            <a class="btn" href={site.links.repo}>
              <Icon name="github" /> 站点仓库
            </a>
          </div>
        </section>

        <section id="credits" data-reveal>
          <h2>来源与致谢</h2>
          <ul class="list" role="list">
            <li>
              内容来源：
              <a class="text-link" href={site.links.resources}>
                vkg-resources
              </a>{' '}
              资源指南，最初整理自{' '}
              <a class="text-link" href="https://blog.homura.work/posts/study/paper/vkg/">
                VKG 学习笔记
              </a>
              。
            </li>
            <li>
              视觉标识：VKG 标志取自组织主页横幅，见{' '}
              <a class="text-link" href={site.links.profile}>
                .github
              </a>{' '}
              仓库。
            </li>
            <li>
              版式参考：早期版本参考了 HTML5 UP 的{' '}
              <a class="text-link" href="https://html5up.net/editorial">
                Editorial
              </a>
              （
              <a class="text-link" href="https://html5up.net/license">
                CC BY 3.0
              </a>
              ）。
            </li>
            <li>外部论文、数据集与软件的版权归原作者所有，本站仅提供链接。</li>
          </ul>
        </section>

        <section id="tech" data-reveal>
          <h2>技术实现</h2>
          <p>
            本站使用{' '}
            <a class="text-link" href="https://astro.build/">
              Astro
            </a>{' '}
            构建为纯静态页面。资源数据以 YAML 维护，构建时按 schema 校验；通过 GitHub Actions
            自动部署至 GitHub Pages，也可部署至 Cloudflare。两个交互示例的三维场景使用 three.js
            渲染，仅在示例页按需加载。站点不使用 Cookie、统计脚本或第三方 CDN。
          </p>
        </section>
      </article>
    ) : (
      <article class="prose">
        <section id="scope" data-reveal>
          <h2>Scope and verification</h2>
          <dl class="facts">
            <div>
              <dt>Scope</dt>
              <dd>
                Standards, tools, tutorials, benchmarks and research directly related to VKG/OBDA,
                together with the surrounding ecosystem for mapping engineering.
              </dd>
            </div>
            <div>
              <dt>Verification</dt>
              <dd>
                Resource information is synchronized with the{' '}
                <a class="text-link" href={site.links.resources}>
                  vkg-resources
                </a>{' '}
                repository and was last verified on{' '}
                <time datetime={site.verifiedAt}>{site.verifiedAt}</time>. Verification covers
                project pages and documentation only; nothing has been installed or run. Check
                versions, data and licenses before use.
              </dd>
            </div>
            <div>
              <dt>Independence</dt>
              <dd>
                All external projects listed are maintained independently by their authors; this
                organization does not represent them.
              </dd>
            </div>
            <div>
              <dt>Languages</dt>
              <dd>
                The site is available in Chinese and English. Resource summaries and the interactive
                examples are maintained in both languages.
              </dd>
            </div>
          </dl>
        </section>

        <section id="contribute" data-reveal>
          <h2>Contributing</h2>
          <ol class="steps" role="list">
            <li>
              <h3>Report a problem</h3>
              <p>
                For broken links, incorrect descriptions or outdated information, open an issue in{' '}
                <a class="text-link" href={site.links.issues}>
                  vkg-resources
                </a>
                .
              </p>
            </li>
            <li>
              <h3>Suggest a resource</h3>
              <p>
                In the issue, provide the name, link, category, a one-sentence summary and any known
                limitations.
              </p>
            </li>
            <li>
              <h3>Edit directly</h3>
              <p>
                Resource data is kept in <code>src/data/resources.yaml</code> in the site
                repository, and pull requests are welcome. Each entry has a Chinese and an English
                summary (<code>summary</code> and <code>summary_en</code>). Fields are validated
                against a schema at build time, and changes that fail validation cannot be merged.
              </p>
            </li>
          </ol>
          <div class="actions">
            <a class="btn btn-primary" href={site.links.issues}>
              Open an issue <Icon name="arrow-right" />
            </a>
            <a class="btn" href={site.links.repo}>
              <Icon name="github" /> Site repository
            </a>
          </div>
        </section>

        <section id="credits" data-reveal>
          <h2>Sources and credits</h2>
          <ul class="list" role="list">
            <li>
              Content: the{' '}
              <a class="text-link" href={site.links.resources}>
                vkg-resources
              </a>{' '}
              resource guide, originally compiled from{' '}
              <a class="text-link" href="https://blog.homura.work/posts/study/paper/vkg/">
                study notes on VKG
              </a>{' '}
              (in Chinese).
            </li>
            <li>
              Visual identity: the VKG logo is taken from the organization profile banner in the{' '}
              <a class="text-link" href={site.links.profile}>
                .github
              </a>{' '}
              repository.
            </li>
            <li>
              Layout: early versions were based on{' '}
              <a class="text-link" href="https://html5up.net/editorial">
                Editorial
              </a>{' '}
              by HTML5 UP (
              <a class="text-link" href="https://html5up.net/license">
                CC BY 3.0
              </a>
              ).
            </li>
            <li>
              Copyrights of external papers, data sets and software belong to their original
              authors; this site only provides links.
            </li>
          </ul>
        </section>

        <section id="tech" data-reveal>
          <h2>Implementation</h2>
          <p>
            The site is built with{' '}
            <a class="text-link" href="https://astro.build/">
              Astro
            </a>{' '}
            as static pages. Resource data is maintained in YAML and validated against a schema at
            build time; the site is deployed to GitHub Pages by GitHub Actions and can also be
            deployed to Cloudflare. The 3D scenes in the two interactive examples are rendered with
            three.js and loaded only on the example pages. The site uses no cookies, analytics
            scripts or third-party CDNs.
          </p>
        </section>
      </article>
    )}
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 64px;
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }

  .toc p {
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--faint);
  }

  .toc ul {
    display: grid;
    gap: 2px;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 6px 14px;
    border-left: 1px solid transparent;
    font-size: 14px;
    color: var(--muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  .prose {
    display: grid;
    gap: 64px;
    max-width: 760px;
  }

  .prose section {
    scroll-margin-top: calc(var(--header-h) + 32px);
  }

  h2 {
    margin-bottom: 24px;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .prose p,
  .prose dd,
  .prose li {
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 8px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-weight: 600;
  }

  .steps {
    display: grid;
    gap: 12px;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 20px 22px 20px 64px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 20px;
    top: 20px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    font: 600 13px var(--font-mono);
    color: var(--accent-ink);
  }

  .steps h3 {
    font-size: 17px;
    font-weight: 650;
  }

  .steps p {
    margin-top: 4px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .list {
    display: grid;
    gap: 12px;
  }

  .list li {
    position: relative;
    padding-left: 20px;
  }

  .list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .facts > div {
      grid-template-columns: 1fr;
    }
  }
</style>
