---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import LearningPath from '../../components/learn/LearningPath.astro';
import Glossary from '../../components/learn/Glossary.astro';
import ContributeBanner from '../../components/ui/ContributeBanner.astro';
import { langOf, langPaths } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url.pathname);
const t = {
  zh: {
    title: '学习路径',
    meta: '面向初次接触虚拟知识图谱的读者：四个学习阶段与常见术语辨析。',
    heading: '从概念到映射工程',
    description:
      '面向初次接触 VKG 的读者，建议按以下四个阶段展开。每个阶段列出学习目标与推荐材料。',
    stages: '学习阶段',
    terms: '术语辨析',
    termsDescription: '以下名称在资料中经常并列出现，含义与适用范围并不相同。',
    note: '所列外部项目均由其作者独立维护，本组织不代表上述项目。',
  },
  en: {
    title: 'Learning path',
    meta: 'For readers new to virtual knowledge graphs: four learning stages and a glossary of commonly confused terms.',
    heading: 'From concepts to mapping engineering',
    description:
      'For readers new to VKG, the following four stages are recommended. Each stage lists its goal and recommended materials.',
    stages: 'Learning stages',
    terms: 'Terminology',
    termsDescription:
      'These names often appear side by side in the literature, but differ in meaning and scope.',
    note: 'All external projects listed are maintained independently by their authors; this organization does not represent them.',
  },
}[lang];
---

<BaseLayout title={t.title} description={t.meta}>
  <PageHeader label={t.title} title={t.heading} description={t.description} art="hero-learn" />

  <section class="container section-tight" aria-label={t.stages}>
    <LearningPath />
  </section>

  <section class="section section-rule" aria-labelledby="terms-title">
    <div class="container">
      <SectionHeading id="terms-title" title={t.terms} description={t.termsDescription} />
      <Glossary />
      <p class="note">{t.note}</p>
    </div>
  </section>

  <ContributeBanner />
</BaseLayout>

<style>
  .section-tight {
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  .note {
    margin-top: 24px;
    font-size: 14px;
    color: var(--faint);
  }
</style>
