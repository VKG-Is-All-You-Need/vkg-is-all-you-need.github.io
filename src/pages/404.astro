---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout title="页面不存在">
  <section class="not-found container">
    <p class="code" aria-hidden="true">404</p>
    <h1>页面不存在</h1>
    <p class="text">请求的页面不存在或已移动。可返回首页，或通过 <kbd>/</kbd> 搜索资源。</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">返回首页 <Icon name="arrow-right" /></a>
      <a class="btn" href="/resources/">浏览资源</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    padding-block: clamp(96px, 16vw, 180px);
    text-align: center;
  }

  .code {
    font: 800 clamp(120px, 22vw, 220px) / 0.9 var(--font-sans);
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    background: radial-gradient(circle at 50% 30%, var(--glow), transparent 60%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  h1 {
    margin-top: 16px;
    font-size: 32px;
    font-weight: 700;
  }

  .text {
    margin-top: 12px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
