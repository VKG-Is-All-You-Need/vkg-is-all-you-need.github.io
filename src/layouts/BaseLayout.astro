---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { site, siteText } from '../data/site';
import { LANG_TAGS, LANGS, basePath, hasTranslation, langOf, localize } from '../i18n';

interface Props {
  /** 页面标题，不含站点名；首页留空。 */
  title?: string;
  description?: string;
}

const lang = langOf(Astro.url.pathname);
const text = siteText[lang];
const { title, description = text.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : text.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 有对应译文的页面标注各语言版本，x-default 指向中文版。
const alternates = hasTranslation(Astro.url.pathname)
  ? LANGS.map((code) => ({
      hreflang: LANG_TAGS[code],
      href: new URL(localize(basePath(Astro.url.pathname), code), Astro.site),
    }))
  : [];
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={LANG_TAGS[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07080a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 在首次绘制前确定主题，避免闪烁；站内跳转后重新应用。 -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let theme;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          doc.documentElement.dataset.theme = theme;
          doc.documentElement.classList.add('js');
        };
        apply(document);
        if (!window.__vkgThemeBound) {
          window.__vkgThemeBound = true;
          document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));
        }
      })();
    </script>
    <!-- 曾切换到英文的读者从站外进入中文首页时，转到英文首页。 -->
    <script is:inline>
      try {
        if (
          location.pathname === '/' &&
          localStorage.getItem('lang') === 'en' &&
          !document.referrer.startsWith(location.origin)
        ) {
          location.replace('/en/' + location.hash);
        }
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      {lang === 'zh' ? '跳至正文' : 'Skip to content'}
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
