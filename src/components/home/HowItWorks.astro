---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { langOf, type Lang } from '../../i18n';

const lang = langOf(Astro.url.pathname);

const texts: Record<
  Lang,
  {
    title: string;
    description: string;
    stepsLabel: string;
    ontology: string;
    ontologyOff: string;
    steps: { title: string; file: string; description: string }[];
    names: [string, string, string];
    simplified: string;
    noInstances: string;
    emptyResult: string;
    result: string;
    rows: (n: number) => string;
    empty: string;
  }
> = {
  zh: {
    title: '工作原理',
    description:
      '以一个包含两张表的数据库为例，说明一条 SPARQL 查询如何经由映射与本体改写为 SQL。示例代码省略了前缀声明。',
    stepsLabel: '工作原理步骤',
    ontology: '加载本体公理',
    ontologyOff: '未加载本体公理：引擎只使用映射。',
    steps: [
      {
        title: '源数据',
        file: 'school.sql',
        description: '学生与教师信息分别存储在两张表中。VKG 不复制、不转换源数据。',
      },
      {
        title: '映射',
        file: 'school.obda',
        description:
          '每条映射由源查询（source）与目标模板（target）组成。模板中的 {id}、{name} 由查询结果逐行填充，每一行对应图中的一个实体。',
      },
      {
        title: '本体（可选）',
        file: 'school.ttl',
        description:
          '仅凭映射即可查询。加入本体公理后，引擎可利用类与属性之间的关系扩展查询答案。缺少这两条公理时，查询结果为空。',
      },
      {
        title: 'SPARQL 查询',
        file: 'query.rq',
        description: '查询仅使用本体词汇，与表结构和列名无关。',
      },
      {
        title: '生成 SQL',
        file: 'rewritten.sql',
        description:
          'Ontop 结合本体与映射，确定 :Person 的实例来自 student 与 teacher 两张表，生成 SQL 交由数据库执行。',
      },
    ],
    names: ['林晓', '周宁', '陈老师'],
    simplified: '-- 简化形式',
    noInstances: '-- 没有映射或公理能推出 :Person 的实例',
    emptyResult: '-- 查询结果为空',
    result: '结果',
    rows: (n) => `${n} 行`,
    empty: '空结果集',
  },
  en: {
    title: 'How it works',
    description:
      'A database with two tables shows how a SPARQL query is rewritten into SQL through mappings and an ontology. Prefix declarations are omitted from the code.',
    stepsLabel: 'Steps',
    ontology: 'Load ontology axioms',
    ontologyOff: 'Ontology axioms not loaded: the engine uses the mappings only.',
    steps: [
      {
        title: 'Source data',
        file: 'school.sql',
        description:
          'Students and teachers are stored in two separate tables. A VKG neither copies nor transforms the source data.',
      },
      {
        title: 'Mappings',
        file: 'school.obda',
        description:
          'Each mapping consists of a source query and a target template. The placeholders {id} and {name} are filled from the query results row by row, and each row becomes one entity in the graph.',
      },
      {
        title: 'Ontology (optional)',
        file: 'school.ttl',
        description:
          'Mappings alone are enough to answer queries. With ontology axioms, the engine uses the relations between classes and properties to extend the answers. Without these two axioms, the query returns no results.',
      },
      {
        title: 'SPARQL query',
        file: 'query.rq',
        description:
          'The query uses only the ontology vocabulary and is independent of table structures and column names.',
      },
      {
        title: 'Generated SQL',
        file: 'rewritten.sql',
        description:
          'Combining the ontology and the mappings, Ontop determines that instances of :Person come from the student and teacher tables, and generates SQL for the database to execute.',
      },
    ],
    names: ['Lin Xiao', 'Zhou Ning', 'Prof. Chen'],
    simplified: '-- simplified',
    noInstances: '-- no mapping or axiom yields instances of :Person',
    emptyResult: '-- the query returns no results',
    result: 'Result',
    rows: (n) => (n === 1 ? '1 row' : `${n} rows`),
    empty: 'Empty result set',
  },
};
const t = texts[lang];
const [s1, s2, t1] = t.names;

const tables = [
  {
    name: 'student',
    rows: [
      ['1', s1],
      ['2', s2],
    ],
  },
  { name: 'teacher', rows: [['1', t1]] },
];
---

<section class="how section section-rule" id="how" aria-labelledby="how-title">
  <div class="container">
    <SectionHeading id="how-title" title={t.title} description={t.description} />

    <div class="demo" data-demo data-reveal>
      <div class="demo-steps" role="tablist" aria-label={t.stepsLabel} aria-orientation="vertical">
        {t.steps.map((step, i) => (
          <button
            type="button"
            role="tab"
            id={`how-tab-${i}`}
            aria-controls={`how-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-step={i}
            data-file={step.file}
          >
            <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-body">
              <span class="step-title">{step.title}</span>
              <span class="step-desc">{step.description}</span>
            </span>
            <span class="step-progress" aria-hidden="true" />
          </button>
        ))}
      </div>

      <div class="demo-window">
        <div class="demo-bar">
          <span class="demo-file">
            <Icon name="file" size={14} />
            <span data-demo-file>{t.steps[0].file}</span>
          </span>
          <label class="switch">
            <input type="checkbox" data-ontology checked />
            <span class="switch-track" aria-hidden="true">
              <span class="switch-thumb"></span>
            </span>
            <span>{t.ontology}</span>
          </label>
        </div>

        <div class="demo-panels">
          <div class="demo-panel" role="tabpanel" id="how-panel-0" aria-labelledby="how-tab-0">
            <div class="db-tables">
              {tables.map((table) => (
                <table>
                  <caption>{table.name}</caption>
                  <thead>
                    <tr>
                      <th>id</th>
                      <th>name</th>
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map(([id, name]) => (
                      <tr>
                        <td>{id}</td>
                        <td>{name}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ))}
            </div>
          </div>

          <div class="demo-panel" role="tabpanel" id="how-panel-1" aria-labelledby="how-tab-1">
            <pre class="code"><code><span class="k">mappingId</span>  student
<span class="k">target</span>     :student/<span class="v">&#123;id&#125;</span> <span class="k">a</span> :Student ; :name <span class="v">&#123;name&#125;</span> .
<span class="k">source</span>     <span class="k">SELECT</span> id, name <span class="k">FROM</span> student

<span class="k">mappingId</span>  teacher
<span class="k">target</span>     :teacher/<span class="v">&#123;id&#125;</span> <span class="k">a</span> :Teacher ; :name <span class="v">&#123;name&#125;</span> .
<span class="k">source</span>     <span class="k">SELECT</span> id, name <span class="k">FROM</span> teacher</code></pre>
          </div>

          <div class="demo-panel" role="tabpanel" id="how-panel-2" aria-labelledby="how-tab-2">
            <div class="ontology">
              <pre class="code"><code>:Student <span class="w">rdfs:subClassOf</span> :Person .
:Teacher <span class="w">rdfs:subClassOf</span> :Person .</code></pre>
              <p class="ontology-off">{t.ontologyOff}</p>
            </div>
          </div>

          <div class="demo-panel" role="tabpanel" id="how-panel-3" aria-labelledby="how-tab-3">
            <pre class="code"><code><span class="k">SELECT</span> <span class="v">?name</span> <span class="k">WHERE</span> &#123;
  <span class="v">?p</span> <span class="k">a</span> :Person ;
     :name <span class="v">?name</span> .
&#125;</code></pre>
          </div>

          <div class="demo-panel" role="tabpanel" id="how-panel-4" aria-labelledby="how-tab-4">
            <div class="with-ontology">
              <pre class="code"><code><span class="c">{t.simplified}</span>
<span class="k">SELECT</span> name <span class="k">FROM</span> student
<span class="k">UNION ALL</span>
<span class="k">SELECT</span> name <span class="k">FROM</span> teacher</code></pre>
              <div class="result">
                <p class="result-head">
                  {t.result} <span>{t.rows(3)}</span>
                </p>
                <table>
                  <thead>
                    <tr>
                      <th>name</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr style="--i:0">
                      <td>{s1}</td>
                    </tr>
                    <tr style="--i:1">
                      <td>{s2}</td>
                    </tr>
                    <tr style="--i:2">
                      <td>{t1}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="without-ontology">
              <pre class="code"><code><span class="c">{t.noInstances}</span>
<span class="c">{t.emptyResult}</span></code></pre>
              <div class="result">
                <p class="result-head">
                  {t.result} <span>{t.rows(0)}</span>
                </p>
                <p class="result-empty">{t.empty}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {lang === 'zh' ? (
      <p class="how-foot" data-reveal>
        示例中的 SQL 为简化形式。实际生成的 SQL 包含表别名与标识符引号，并可能附加{' '}
        <code>IS NOT NULL</code> 等条件。完整流程参见{' '}
        <a class="text-link" href="https://ontop-vkg.org/tutorial/">
          Ontop 官方教程
        </a>
        。
      </p>
    ) : (
      <p class="how-foot" data-reveal>
        The SQL shown is simplified. The actual SQL includes table aliases and quoted identifiers,
        and may add conditions such as <code>IS NOT NULL</code>. For the complete workflow, see the{' '}
        <a class="text-link" href="https://ontop-vkg.org/tutorial/">
          Ontop tutorial
        </a>
        .
      </p>
    )}
  </div>
</section>

<style>
  .demo {
    --step-duration: 6s;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 24px;
    align-items: start;
  }

  /* 步骤列表 */
  .demo-steps {
    display: grid;
    gap: 6px;
  }

  [role='tab'] {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid transparent;
    text-align: left;
    overflow: hidden;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  [role='tab']:hover {
    background: var(--surface);
  }

  [role='tab'][aria-selected='true'] {
    background: var(--surface);
    border-color: var(--line);
  }

  .step-index {
    font: 500 13px/1.9 var(--font-mono);
    color: var(--faint);
    transition: color 0.3s;
  }

  [aria-selected='true'] .step-index {
    color: var(--accent-ink);
  }

  .step-body {
    display: grid;
    gap: 4px;
  }

  .step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-2);
  }

  [aria-selected='true'] .step-title {
    color: var(--ink);
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    overflow: hidden;
  }

  .demo[data-ready] .step-desc {
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.45s var(--ease),
      opacity 0.3s;
  }

  .demo[data-ready] [aria-selected='true'] .step-desc {
    max-height: 120px;
    opacity: 1;
  }

  .step-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    box-shadow: 0 0 12px var(--glow);
  }

  .demo[data-playing] [aria-selected='true'] .step-progress {
    animation: progress var(--step-duration) linear forwards;
  }

  .demo[data-playing]:hover [aria-selected='true'] .step-progress,
  .demo[data-playing]:focus-within [aria-selected='true'] .step-progress {
    animation-play-state: paused;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /* 代码窗口 */
  .demo-window {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--code-bg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .demo-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 10px 14px 10px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
    color: var(--code-faint);
    font-size: 13px;
  }

  .demo-file {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    color: var(--code-ink);
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    color: #c8ccd1;
    user-select: none;
  }

  .switch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .switch-track {
    position: relative;
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    transition: background-color 0.3s;
  }

  .switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.3s var(--ease);
  }

  .switch input:checked + .switch-track {
    background: #c99a3c;
  }

  .switch input:checked + .switch-track .switch-thumb {
    transform: translateX(14px);
  }

  .switch input:focus-visible + .switch-track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .demo-panels {
    min-height: 300px;
    padding: 24px;
  }

  .demo[data-ready] .demo-panel:not(.is-active) {
    display: none;
  }

  .demo:not([data-ready]) .demo-panel + .demo-panel {
    margin-top: 28px;
  }

  .demo-panel.is-active {
    animation: panel-in 0.5s var(--ease);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(4px);
    }
  }

  .code {
    margin: 0;
    font: 13.5px/1.85 var(--font-mono);
    color: var(--code-ink);
    overflow-x: auto;
  }

  .code code {
    font: inherit;
  }

  .code .k {
    color: var(--code-kw);
  }

  .code .v {
    color: var(--code-var);
  }

  .code .w {
    color: var(--code-var);
  }

  .code .c {
    color: var(--code-faint);
  }

  /* 本体开关：未加载时淡化公理 */
  .ontology-off {
    display: none;
    margin-top: 16px;
    font-size: 13px;
    color: var(--code-var);
  }

  .demo:has([data-ontology]:not(:checked)) .ontology .code {
    opacity: 0.3;
    text-decoration: line-through;
    text-decoration-color: rgb(255 255 255 / 0.3);
  }

  .demo:has([data-ontology]:not(:checked)) .ontology-off {
    display: block;
  }

  .without-ontology,
  .demo:has([data-ontology]:not(:checked)) .with-ontology {
    display: none;
  }

  .demo:has([data-ontology]:not(:checked)) .without-ontology {
    display: block;
  }

  /* 表格与结果 */
  .db-tables {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  table {
    border-collapse: collapse;
    font: 13.5px/1.6 var(--font-mono);
    color: var(--code-ink);
  }

  .db-tables table {
    min-width: 190px;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 10px;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }

  caption {
    padding-bottom: 8px;
    text-align: left;
    font-weight: 600;
    color: var(--code-kw);
  }

  th {
    padding: 7px 16px;
    text-align: left;
    font-weight: 400;
    color: var(--code-faint);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.03);
  }

  td {
    padding: 7px 16px;
    font-family: var(--font-mono), var(--font-sans);
  }

  tbody tr + tr td {
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }

  .result {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px dashed rgb(255 255 255 / 0.12);
  }

  .result-head {
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--code-faint);
  }

  .result-head span {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgb(127 211 236 / 0.12);
    color: var(--code-kw);
  }

  .result table {
    min-width: 220px;
  }

  .is-active .result tbody tr {
    animation: row-in 0.5s var(--ease) both;
    animation-delay: calc(300ms + var(--i) * 140ms);
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  .result-empty {
    font: 13px var(--font-mono);
    color: var(--code-faint);
  }

  .how-foot {
    margin-top: 32px;
    font-size: 14px;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .demo {
      grid-template-columns: 1fr;
    }

    .demo-window {
      position: static;
    }

    .demo-steps {
      grid-auto-flow: column;
      grid-auto-columns: minmax(150px, 1fr);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .demo[data-ready] [aria-selected='true'] .step-desc {
      max-height: 0;
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .demo-panels {
      padding: 18px 16px;
    }

    .code {
      font-size: 12.5px;
    }

    .switch > span:last-child {
      display: none;
    }
  }
</style>
