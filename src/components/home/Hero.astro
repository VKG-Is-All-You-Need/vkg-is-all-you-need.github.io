---
import ProjectionGraph from './ProjectionGraph.astro';
import Icon from '../ui/Icon.astro';
import { categories } from '../../data/categories';
import { site } from '../../data/site';
import { getResources } from '../../lib/resources';

const total = (await getResources()).length;
---

<section class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid dot-grid"></div>
    <div class="hero-aurora"></div>
    <div class="hero-pointer"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-label">
        <span class="live-dot"></span>虚拟知识图谱 · OBDA · 资源索引
      </p>
      <h1>
        <span class="h1-mark">VKG</span>
        <span class="h1-serif">is all you need</span>
      </h1>
      <p class="hero-lede">
        虚拟知识图谱（Virtual Knowledge
        Graph，VKG）以本体和映射为桥梁，将关系数据库中的数据呈现为知识图谱。数据保留在原始数据源中，SPARQL
        查询在执行时被改写为 SQL。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/resources/">
          浏览资源 <Icon name="arrow-right" />
        </a>
        <a class="btn" href="#how">
          了解工作原理
        </a>
      </div>
      <dl class="hero-facts">
        <div>
          <dt>收录资源</dt>
          <dd>{total} 项</dd>
        </div>
        <div>
          <dt>资源分类</dt>
          <dd>{categories.length} 类</dd>
        </div>
        <div>
          <dt>最近核对</dt>
          <dd>
            <time datetime={site.verifiedAt}>{site.verifiedAt}</time>
          </dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual" data-tilt>
      <ProjectionGraph />
    </div>
  </div>
</section>

<style>
  .hero {
    --px: 70%;
    --py: 30%;
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 96px));
    padding-bottom: clamp(40px, 5vw, 72px);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 25%, transparent 75%);
  }

  .hero-aurora {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 70%;
    height: 110%;
    background:
      radial-gradient(closest-side at 60% 40%, var(--glow), transparent),
      radial-gradient(
        closest-side at 30% 70%,
        color-mix(in srgb, var(--code-var) 22%, transparent),
        transparent
      );
    filter: blur(60px);
    opacity: 0.5;
    animation: drift 18s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate(-6%, 8%) rotate(8deg) scale(1.08);
    }
  }

  .hero-pointer {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      520px circle at var(--px) var(--py),
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px;
    color: var(--ink-2);
  }

  .live-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  h1 {
    display: grid;
    margin: 28px 0 28px;
    line-height: 0.92;
  }

  .h1-mark {
    font-size: clamp(72px, 10vw, 136px);
    font-weight: 800;
    letter-spacing: -0.055em;
    background: linear-gradient(
      100deg,
      var(--ink) 30%,
      color-mix(in srgb, var(--accent) 70%, var(--ink)) 50%,
      var(--ink) 70%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 7s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    20% {
      background-position: 100% 0;
    }
    60%,
    100% {
      background-position: 0% 0;
    }
  }

  .h1-serif {
    margin-top: 0.08em;
    font: italic 400 clamp(44px, 5.6vw, 76px) / 1 var(--font-serif);
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .hero-lede {
    max-width: 34em;
    font-size: clamp(16px, 1.4vw, 18px);
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .hero-facts dt {
    font-size: 12px;
    color: var(--faint);
  }

  .hero-facts dd {
    margin-top: 2px;
    font: 500 15px var(--font-mono);
    color: var(--ink);
  }

  .hero-visual {
    --rx: 0deg;
    --ry: 0deg;
    transform: perspective(1400px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease);
    animation: float-in 1s var(--ease);
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-visual {
      max-width: 680px;
    }
  }
</style>
