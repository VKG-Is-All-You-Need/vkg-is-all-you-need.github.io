---
import FanOutGraph from './FanOutGraph.astro';
import Icon from '../ui/Icon.astro';
import { categoriesOf } from '../../data/categories';
import { site } from '../../data/site';
import { langOf, localize } from '../../i18n';
import { getResources } from '../../lib/resources';

const lang = langOf(Astro.url.pathname);
const total = (await getResources()).length;
const categoryCount = categoriesOf(lang).length;
const t = {
  zh: {
    label: '虚拟知识图谱 · OBDA · 资源索引',
    browse: '浏览资源',
    what: '能做什么',
    resources: '收录资源',
    resourceCount: `${total} 项`,
    categories: '资源分类',
    categoryCount: `${categoryCount} 类`,
    verified: '最近核对',
  },
  en: {
    label: 'Virtual knowledge graphs · OBDA · Resources',
    browse: 'Browse resources',
    what: 'What it does',
    resources: 'Resources',
    resourceCount: String(total),
    categories: 'Categories',
    categoryCount: String(categoryCount),
    verified: 'Last verified',
  },
}[lang];
---

<section class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid dot-grid"></div>
    <div class="hero-aurora"></div>
    <div class="hero-pointer"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-label">
        <span class="live-dot"></span>
        {t.label}
      </p>
      <div class="hero-heading">
        <h1>
          <span class="h1-mark">VKG</span>
        </h1>
        <figure class="hero-quote">
          <blockquote>
            <p class="quote-english" lang="en">
              Being <span>qua</span> being.
            </p>
            <p class="quote-greek" lang="grc">
              Τὸ ὂν ᾗ ὄν.
            </p>
          </blockquote>
          <figcaption lang="en">
            <span class="quote-author">— Aristotle</span>
            <span class="quote-source">
              <cite>《Metaphysics》</cite> IV.1 · 1003a21
            </span>
          </figcaption>
        </figure>
      </div>
      {lang === 'zh' ? (
        <p class="hero-lede">
          虚拟知识图谱（Virtual Knowledge
          Graph，VKG）用一套业务词汇查询分散在多个数据库中的数据。本体定义词汇，映射把词汇关联到各数据源的表与列，SPARQL
          查询在执行时改写为 SQL，数据保留在原始数据源中，无需迁移或复制。
        </p>
      ) : (
        <p class="hero-lede">
          A virtual knowledge graph (VKG) lets you query data spread across many databases in one
          business vocabulary. An ontology defines the vocabulary, mappings tie it to the tables and
          columns of each source, and SPARQL queries are rewritten into SQL at query time. The data
          stays in the original sources, with no migration or copying.
        </p>
      )}
      <div class="hero-actions">
        <a class="btn btn-primary" href={localize('/resources/', lang)}>
          {t.browse} <Icon name="arrow-right" />
        </a>
        <a class="btn" href="#what">
          {t.what}
        </a>
      </div>
      <dl class="hero-facts">
        <div>
          <dt>{t.resources}</dt>
          <dd>{t.resourceCount}</dd>
        </div>
        <div>
          <dt>{t.categories}</dt>
          <dd>{t.categoryCount}</dd>
        </div>
        <div>
          <dt>{t.verified}</dt>
          <dd>
            <time datetime={site.verifiedAt}>{site.verifiedAt}</time>
          </dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual" data-tilt>
      <FanOutGraph />
    </div>
  </div>
</section>

<style>
  .hero {
    --px: 70%;
    --py: 30%;
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 96px));
    padding-bottom: clamp(40px, 5vw, 72px);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 25%, transparent 75%);
  }

  .hero-aurora {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 70%;
    height: 110%;
    background:
      radial-gradient(closest-side at 60% 40%, var(--glow), transparent),
      radial-gradient(
        closest-side at 30% 70%,
        color-mix(in srgb, var(--code-var) 22%, transparent),
        transparent
      );
    filter: blur(60px);
    opacity: 0.5;
    animation: drift 18s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate(-6%, 8%) rotate(8deg) scale(1.08);
    }
  }

  .hero-pointer {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      520px circle at var(--px) var(--py),
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px;
    color: var(--ink-2);
  }

  .live-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .hero-heading {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(20px, 2.5vw, 36px);
    margin: 36px 0 34px;
  }

  h1 {
    display: grid;
    margin: 0;
    line-height: 0.92;
  }

  .h1-mark {
    font-size: clamp(64px, 9vw, 124px);
    font-weight: 800;
    letter-spacing: -0.055em;
    background: linear-gradient(
      100deg,
      var(--ink) 30%,
      color-mix(in srgb, var(--accent) 70%, var(--ink)) 50%,
      var(--ink) 70%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 7s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    20% {
      background-position: 100% 0;
    }
    60%,
    100% {
      background-position: 0% 0;
    }
  }

  .hero-quote {
    width: max-content;
    margin: 0;
    padding: 2px 0 2px clamp(16px, 2vw, 24px);
    border-left: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
  }

  .hero-quote blockquote {
    position: relative;
    margin: 0;
  }

  .quote-english {
    margin: 0;
    white-space: nowrap;
    font:
      400 clamp(25px, 2.5vw, 32px) / 1.05 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }

  .quote-english span {
    font-style: italic;
    color: color-mix(in srgb, var(--accent) 65%, var(--ink));
  }

  .quote-greek {
    margin: 10px 0 0;
    font:
      italic 400 26px / 1.25 Georgia,
      'Times New Roman',
      serif;
    color: var(--ink-2);
  }

  .hero-quote figcaption {
    display: grid;
    width: max-content;
    min-width: 100%;
    gap: 7px;
    white-space: nowrap;
    margin-top: 3px;
    text-align: right;
    line-height: 1.45;
    color: var(--muted);
  }

  .quote-author {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.25;
    color: var(--ink-2);
  }

  .quote-source {
    font-size: 15px;
  }

  .hero-lede {
    max-width: 34em;
    font-size: clamp(16px, 1.4vw, 18px);
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .hero-facts dt {
    font-size: 12px;
    color: var(--faint);
  }

  .hero-facts dd {
    margin-top: 2px;
    font: 500 15px var(--font-mono);
    color: var(--ink);
  }

  .hero-visual {
    --rx: 0deg;
    --ry: 0deg;
    transform: perspective(1400px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease);
    animation: float-in 1s var(--ease);
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-visual {
      max-width: 680px;
    }
  }
</style>
