---
import '../../styles/explorer.css';
import Icon from '../ui/Icon.astro';
import WeatherIcon from './WeatherIcon.astro';
import { cityQueries, queryGroups } from '../../lib/city/queries';
import { ALL_SOURCES, SOURCES } from '../../lib/city/sources';
import { dayMarkers } from '../../lib/city/calendar';
import { DAY_END, DAY_START, DAYS, dayOf, formatTime, hours, timeOfDay } from '../../lib/city/time';
import { DAY_WEATHER, observationAt } from '../../lib/city/weather';
import { term } from '../../lib/geo/names';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url.pathname);
const queries = cityQueries();
const first = queries[0];
const initial = first.run({ t: first.suggest, sources: new Set(ALL_SOURCES), detail: true });
const initialDay = dayOf(first.suggest);
const observation = observationAt(first.suggest);
const percent = (seconds: number) => ((seconds - DAY_START) / (DAY_END - DAY_START)) * 100;

const t = {
  zh: {
    days: '日期',
    humidity: '湿度',
    queries: '示例查询',
    groups: '查询分组',
    people: '人物数据',
    peopleView: '人物数据的展示方式',
    aggregate: '聚合',
    detail: '明细（虚构）',
    results: '结果',
    sources: '数据源',
    connected: `${SOURCES.length} / ${SOURCES.length} 已接入`,
    need: '需要',
    presetsLabel: '快捷组合',
    presets: ['全部接入', '只接 GIS', '交通 + 气象', '人与出行'],
    sourcesHint: '关闭某个数据源，看看哪些结果会消失或退化。标记“需要”的是当前查询依赖的数据源。',
    time: '模拟时间',
    play: '播放',
    speed: '播放速度',
    view: '视图',
    city: '城市',
    layers: '分层',
    night: '夜景显示',
    nightOn: '夜景显示：已开启',
    reset: '复位视角',
    fullscreen: '全屏',
    hintTitle: '分层视图',
    hint: '查询结果按来源分层展示：底层是八个独立的数据源，经映射汇入虚拟知识图谱，顶层是本体。由多个数据源描述的同一实体在图谱层合并为一个节点。',
    hintGo: '查看分层视图',
    hintLater: '稍后再看',
  },
  en: {
    days: 'Day',
    humidity: 'humidity',
    queries: 'Example queries',
    groups: 'Query groups',
    people: 'People data',
    peopleView: 'How people data is shown',
    aggregate: 'Aggregate',
    detail: 'Detail (fictional)',
    results: 'Results',
    sources: 'Data sources',
    connected: `${SOURCES.length} / ${SOURCES.length} connected`,
    need: 'Needed',
    presetsLabel: 'Presets',
    presets: ['All sources', 'GIS only', 'Traffic + weather', 'People and mobility'],
    sourcesHint:
      'Switch off a source to see which results disappear or degrade. Sources marked "Needed" are used by the current query.',
    time: 'Simulated time',
    play: 'Play',
    speed: 'Playback speed',
    view: 'View',
    city: 'City',
    layers: 'Layers',
    night: 'Night view',
    nightOn: 'Night view: on',
    reset: 'Reset view',
    fullscreen: 'Full screen',
    hintTitle: 'Layered view',
    hint: 'The layered view arranges query results by source: the eight independent data sources at the bottom feed into the virtual knowledge graph through mappings, with the ontology on top. An entity described by several sources becomes a single node in the graph layer.',
    hintGo: 'Open the layered view',
    hintLater: 'Later',
  },
}[lang];

const presets = ['all', 'gis', 'mobility', 'people'].map((id, i) => ({
  id,
  label: t.presets[i],
}));
---

<div class="city xp" data-city>
  <div class="stage city-stage" data-city-stage>
    <div class="viewport" data-city-viewport>
      <div class="pins" data-city-pins aria-hidden="true"></div>
      <p class="status" data-city-status role="status"></p>
      <div class="top">
        <div class="days" role="group" aria-label={t.days}>
          {DAYS.map((day) => {
            const weather = DAY_WEATHER[day.index];
            return (
              <button
                type="button"
                class:list={['day', `day-${weather.kind}`]}
                data-city-day={day.index}
                aria-pressed={day.index === initialDay ? 'true' : 'false'}
                title={`${term(day.label)} · ${term(weather.summary)} · ${weather.low}–${weather.high}°C`}
              >
                <span class="day-label">{term(day.label)}</span>
                <WeatherIcon kind={weather.kind} />
                <span class="day-temp">
                  {weather.high}°<i>{weather.low}°</i>
                </span>
              </button>
            );
          })}
        </div>
        <div class="hud" aria-live="polite">
          <span class="hud-clock" data-city-clock>
            {formatTime(first.suggest)}
          </span>
          <span class="hud-weather" data-city-weather>
            {term(observation.condition)} · {Math.round(observation.temperature)}°C · {t.humidity}{' '}
            {observation.humidity}%
          </span>
        </div>
      </div>
      <div class="detail-card" data-city-card hidden aria-live="polite"></div>
    </div>

    <aside class="panel panel-queries" aria-label={t.queries}>
      <div class="group-tabs" role="tablist" aria-label={t.groups}>
        {queryGroups().map((group, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-group-tab={group.id}
          >
            {group.label}
          </button>
        ))}
      </div>
      <div class="queries">
        {queries.map((query, i) => (
          <button
            type="button"
            data-city-query={query.id}
            data-group={query.group}
            aria-pressed={i === 0 ? 'true' : 'false'}
            hidden={query.group !== first.group}
          >
            <span class="q-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="q-body">
              <span class="q-title">{query.title}</span>
              <span class="q-feature">
                {query.sources.map((id) => SOURCES.find((s) => s.id === id)!.name).join(' + ')}
              </span>
            </span>
          </button>
        ))}
      </div>
      <div class="privacy">
        <span>{t.people}</span>
        <div class="segmented" role="group" aria-label={t.peopleView}>
          <button type="button" data-city-detail="false" aria-pressed="false">
            {t.aggregate}
          </button>
          <button type="button" data-city-detail="true" aria-pressed="true">
            {t.detail}
          </button>
        </div>
      </div>
      <div class="results" data-city-result>
        <p class="results-head">
          {t.results} <span>{initial.summary}</span>
        </p>
        <ul class="notes" role="list">
          {initial.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
        <ul role="list">
          {initial.rows.map((row) => (
            <li>
              <span class:list={['result', { 'is-miss': !row.hit }]}>
                <span class="result-name">{row.title}</span>
                <span class="result-detail">{row.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <aside class="panel panel-sources" aria-label={t.sources}>
      <div class="sources-head">
        <p class="panel-label">{t.sources}</p>
        <span class="sources-count" data-city-source-count>
          {t.connected}
        </span>
      </div>
      <ul class="sources" role="list">
        {SOURCES.map((source) => (
          <li>
            <label class="source" style={`--source:${source.color}`}>
              <input type="checkbox" checked data-source={source.id} />
              <span class="source-dot" aria-hidden="true" />
              <span class="source-body">
                <span class="source-name">{source.name}</span>
                <span class="source-system">{source.system}</span>
              </span>
              <span class="source-need" data-source-need={source.id} hidden>
                {t.need}
              </span>
              <span class="source-switch" aria-hidden="true">
                <span />
              </span>
            </label>
          </li>
        ))}
      </ul>
      <div class="presets" role="group" aria-label={t.presetsLabel}>
        {presets.map((preset) => (
          <button type="button" data-city-preset={preset.id}>
            {preset.label}
          </button>
        ))}
      </div>
      <p class="sources-hint">{t.sourcesHint}</p>
    </aside>

    <div class="timeline" role="group" aria-label={t.time}>
      <button type="button" class="play" data-city-play aria-pressed="false" aria-label={t.play}>
        <svg class="when-paused" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5v14l12-7z" fill="currentColor"></path>
        </svg>
        <svg class="when-playing" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"></path>
        </svg>
      </button>
      <div class="speeds" role="group" aria-label={t.speed}>
        {[1, 10, 60, 300].map((speed) => (
          <button
            type="button"
            data-city-speed={speed}
            aria-pressed={speed === 10 ? 'true' : 'false'}
          >
            ×{speed}
          </button>
        ))}
      </div>
      <div class="track">
        <div class="markers" aria-hidden="true" data-city-markers>
          {dayMarkers(initialDay).map((m) => (
            <span
              class:list={['marker', `marker-${m.kind}`]}
              style={`left:${percent(m.from)}%;width:${percent(m.to) - percent(m.from)}%`}
              title={`${term(m.label)} ${formatTime(m.from)}–${formatTime(m.to)}`}
            >
              <i>{term(m.label)}</i>
            </span>
          ))}
        </div>
        <input
          type="range"
          min={DAY_START}
          max={DAY_END - 60}
          step="60"
          value={timeOfDay(first.suggest)}
          aria-label={t.time}
          data-city-time
        />
        <div class="ticks" aria-hidden="true">
          {[6, 9, 12, 15, 18, 21, 24].map((h) => (
            <span style={`left:${percent(hours(h))}%`}>{h}:00</span>
          ))}
        </div>
      </div>
      <div class="timeline-tools">
        <div class="view-switch" role="group" aria-label={t.view}>
          <button type="button" data-city-view="city" aria-pressed="true">
            <Icon name="map" size={15} />
            <span>{t.city}</span>
          </button>
          <button type="button" data-city-view="layers" aria-pressed="false">
            <Icon name="layers" size={15} />
            <span>{t.layers}</span>
          </button>
        </div>
        <button
          type="button"
          data-city-night
          aria-pressed="true"
          aria-label={t.night}
          title={t.nightOn}
        >
          <Icon name="moon" size={16} />
        </button>
        <button type="button" data-city-reset aria-label={t.reset}>
          <Icon name="home" size={16} />
        </button>
        <button type="button" data-city-fullscreen aria-pressed="false" aria-label={t.fullscreen}>
          <Icon name="maximize" size={16} class="when-normal" />
          <Icon name="minimize" size={16} class="when-full" />
        </button>
        <div class="view-hint" data-city-hint role="note" hidden>
          <p class="view-hint-title">{t.hintTitle}</p>
          <p>{t.hint}</p>
          <div class="view-hint-actions">
            <button type="button" class="view-hint-go" data-city-hint-go>
              {t.hintGo}
            </button>
            <button type="button" class="view-hint-later" data-city-hint-close>
              {t.hintLater}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .city-stage {
    height: clamp(620px, 84vh, 780px);
  }

  .panel-queries {
    bottom: 92px;
  }

  .panel-sources {
    top: 16px;
    right: 16px;
    bottom: 92px;
    width: 264px;
  }

  /* 日期、时钟与天气 */
  .top {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 2;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .days {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .day {
    display: grid;
    justify-items: center;
    gap: 1px;
    width: 52px;
    padding: 4px 0 3px;
    border-radius: 10px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--muted);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .day:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .day[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--ink);
  }

  .day :global(.weather-icon) {
    color: var(--muted);
  }

  .day-sunny :global(.weather-icon) {
    color: #e3b341;
  }

  .day-hot :global(.weather-icon) {
    color: #ff8a4c;
  }

  .day-rain :global(.weather-icon),
  .day-storm :global(.weather-icon) {
    color: #7f9cff;
  }

  .day-cold :global(.weather-icon) {
    color: #6fb6d0;
  }

  .day-temp {
    font: 11px var(--font-mono);
  }

  .day-temp i {
    margin-left: 2px;
    font-style: normal;
    color: var(--faint);
  }

  .hud {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 6px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    white-space: nowrap;
  }

  .hud-clock {
    font: 600 20px var(--font-mono);
    letter-spacing: 0.02em;
  }

  .hud-weather {
    font-size: 13px;
    color: var(--muted);
  }

  .hud-weather:global(.is-off) {
    color: var(--warn);
  }

  /* 对象详情：同一对象在各数据源中的记录 */
  .detail-card {
    position: absolute;
    left: 50%;
    bottom: 92px;
    z-index: 2;
    translate: -50% 0;
    width: min(360px, calc(100% - 640px));
    min-width: 280px;
    max-height: calc(100% - 92px - 72px);
    overflow-y: auto;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: var(--shadow);
    animation: card-in 0.35s var(--ease);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .detail-card :global(.card-head) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .detail-card :global(.card-kind) {
    font-size: 12px;
    color: var(--accent-ink);
  }

  .detail-card :global(.card-title) {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .detail-card :global(.card-close) {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--muted);
  }

  .detail-card :global(.card-actions) {
    display: flex;
    flex: none;
    gap: 2px;
  }

  .detail-card :global(.card-close:hover) {
    background: var(--surface-2);
    color: var(--ink);
  }

  .detail-card :global(.card-iri) {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin: 4px 0 10px;
    font: 12px var(--font-mono);
    color: var(--faint);
  }

  .detail-card :global(.card-iri code) {
    padding: 0;
    background: none;
    color: var(--ink-2);
  }

  .detail-card :global(.card-rows) {
    display: grid;
    gap: 4px;
  }

  .detail-card :global(.card-rows li) {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 10px;
    padding: 6px 8px 6px 10px;
    border-left: 3px solid var(--source);
    border-radius: 4px 8px 8px 4px;
    background: var(--surface-2);
    font-size: 12.5px;
    line-height: 1.55;
  }

  .detail-card :global(.card-source) {
    color: var(--muted);
  }

  .detail-card :global(.card-rows li.is-off) {
    border-left-color: var(--line-strong);
    background: none;
  }

  .detail-card :global(.card-rows li.is-off .card-text) {
    color: var(--warn);
  }

  .detail-card :global(.card-foot) {
    margin-top: 10px;
    font-size: 12px;
    color: var(--faint);
  }

  .detail-card :global(.card-foot .to-layers) {
    margin-top: 4px;
  }

  /* 卡片中的实体名称：点击跳转到该实体 */
  .detail-card :global(.card-link) {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--accent-ink);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .detail-card :global(.card-link:hover) {
    text-decoration-style: solid;
  }

  .detail-card :global(.card-back) {
    margin-bottom: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  .detail-card :global(.card-back:hover) {
    color: var(--accent-ink);
  }

  /* 收起后只保留标题，选中与跟随不变 */
  .detail-card:global(.is-collapsed) {
    padding-block: 10px;
  }

  .detail-card:global(.is-collapsed) :global(.card-head) {
    cursor: pointer;
  }

  .detail-card:global(.is-collapsed) :global(.card-title) {
    font-size: 15px;
  }

  .detail-card:global(.is-collapsed) :global(.card-iri),
  .detail-card:global(.is-collapsed) :global(.card-rows),
  .detail-card:global(.is-collapsed) :global(.card-truth),
  .detail-card:global(.is-collapsed) :global(.card-foot) {
    display: none;
  }

  /* 模拟实况：不属于任何数据源 */
  .detail-card :global(.card-truth) {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 10px;
    margin-top: 4px;
    padding: 6px 8px 6px 10px;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .detail-card :global(.card-truth span) {
    color: var(--muted);
  }

  /* 查询列表较长：只在选中的查询下显示所需数据源 */
  .queries button[aria-pressed='false'] .q-feature {
    display: none;
  }

  /* 查询分组 */
  .group-tabs {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface-2);
  }

  .group-tabs button {
    flex: 1;
    padding: 5px 0;
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .group-tabs button[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.15);
  }

  .privacy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .segmented {
    display: flex;
    padding: 2px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }

  .segmented button {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .segmented button[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .results :global(.notes) {
    display: grid;
    gap: 6px;
    margin-bottom: 10px;
  }

  .results :global(.notes li) {
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--surface-2);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .results :global(.notes li.is-missing) {
    background: color-mix(in srgb, var(--warn) 12%, transparent);
    color: var(--ink-2);
  }

  .results :global(.results-head.is-unavailable span) {
    background: color-mix(in srgb, var(--warn) 18%, transparent);
    color: var(--warn);
  }

  .results :global(.result-actions) {
    display: flex;
    gap: 6px;
    margin: 4px 0 10px;
  }

  .results :global(.result-actions button) {
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 12px;
    color: var(--accent-ink);
  }

  /* 数据源 */
  .sources-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .sources-count {
    font: 12px var(--font-mono);
    color: var(--faint);
  }

  .sources {
    display: grid;
    gap: 4px;
  }

  .source {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .source:hover {
    background: var(--surface-2);
  }

  .source input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .source-dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 3px;
    background: var(--source);
    box-shadow: 0 0 10px color-mix(in srgb, var(--source) 60%, transparent);
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }

  .source-body {
    display: grid;
    min-width: 0;
    line-height: 1.4;
  }

  .source-name {
    font-size: 13.5px;
  }

  .source-system {
    font: 11px var(--font-mono);
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
