---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { categoriesOf } from '../data/categories';
import { site } from '../data/site';
import { langOf, localize } from '../i18n';

const lang = langOf(Astro.url.pathname);
const t = {
  zh: {
    site: '站点',
    pages: [
      ['首页', '/'],
      ['工作原理', '/#how'],
      ['资源索引', '/resources/'],
      ['论文与代码仓库', '/papers/'],
      ['发展历程', '/history/'],
      ['学习路径', '/learn/'],
      ['地理信息示例', '/examples/geo/'],
      ['城市数据融合示例', '/examples/city/'],
      ['设备诊断示例', '/examples/turbine/'],
      ['关于本站', '/about/'],
    ],
    categories: '资源分类',
    community: '社区',
    org: 'GitHub 组织',
    issue: '提交 issue',
    repo: '站点源码',
    tagline: '虚拟知识图谱（VKG）与 OBDA 资源索引。',
    verified: '资源信息最近核对于',
    rights: '。外部资源的版权与许可归各自权利人所有。',
    top: '返回顶部',
  },
  en: {
    site: 'Site',
    pages: [
      ['Home', '/'],
      ['How it works', '/#how'],
      ['Resources', '/resources/'],
      ['Papers and repositories', '/papers/'],
      ['History', '/history/'],
      ['Learning path', '/learn/'],
      ['Geospatial example', '/examples/geo/'],
      ['Urban data fusion example', '/examples/city/'],
      ['Equipment diagnostics example', '/examples/turbine/'],
      ['About', '/about/'],
    ],
    categories: 'Categories',
    community: 'Community',
    org: 'GitHub organization',
    issue: 'Open an issue',
    repo: 'Site source',
    tagline: 'An index of virtual knowledge graph (VKG) and OBDA resources.',
    verified: 'Resource information last verified on',
    rights: '. Copyrights and licenses of external resources belong to their respective holders.',
    top: 'Back to top',
  },
}[lang];

const columns = [
  {
    title: t.site,
    links: t.pages.map(([label, href]) => ({
      label,
      href: localize(href, lang),
    })),
  },
  {
    title: t.categories,
    links: categoriesOf(lang).map((category) => ({
      label: category.label,
      href: localize(`/resources/?category=${category.id}`, lang),
    })),
  },
  {
    title: t.community,
    links: [
      { label: t.org, href: site.links.org },
      { label: 'vkg-resources', href: site.links.resources },
      { label: t.issue, href: site.links.issues },
      { label: t.repo, href: site.links.repo },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href={localize('/', lang)}>
          <Logo size={34} />
          <span>
            VKG <em>is all you need</em>
          </span>
        </a>
        <p>{t.tagline}</p>
      </div>
      {columns.map((column) => (
        <nav class="footer-column" aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul role="list">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <p>
        {t.verified} <time datetime={site.verifiedAt}>{site.verifiedAt}</time>
        {t.rights}
      </p>
      <a class="to-top" href="#top">
        {t.top} <Icon name="arrow-up" size={14} />
      </a>
    </div>
  </div>
  <div class="footer-wordmark" aria-hidden="true">
    VKG
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding-top: 64px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
  }

  .brand em {
    font: italic 400 18px var(--font-serif);
    color: var(--muted);
  }

  .footer-brand p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
  }

  .footer-column h2 {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--faint);
  }

  .footer-column ul {
    display: grid;
    gap: 8px;
  }

  .footer-column a {
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .footer-column a:hover {
    color: var(--accent-ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--faint);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .to-top:hover {
    color: var(--ink);
  }

  .footer-wordmark {
    margin-top: 8px;
    font-weight: 800;
    font-size: clamp(120px, 26vw, 360px);
    line-height: 0.74;
    letter-spacing: -0.06em;
    text-align: center;
    color: transparent;
    background: linear-gradient(180deg, var(--line-strong), transparent 75%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
