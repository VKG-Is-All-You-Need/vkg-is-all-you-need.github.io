---
/**
 * 发展历程每个时期的概念示意图（SVG）。进入视口时（data-reveal → .is-revealed）依次播放，
 * 之后连线上保留流动效果；偏好减少动效时直接显示最终状态。
 */
import { langOf } from '../../i18n';

interface Props {
  era: 'origins' | 'systems' | 'industry' | 'federation' | 'now';
}

const { era } = Astro.props;
const lang = langOf(Astro.url.pathname);

/** 数据库圆柱：外轮廓与顶面的弧线。 */
const cylinder = (x: number, y: number, w: number, h: number) => ({
  body: `M${x} ${y + 6} a${w / 2} 6 0 0 1 ${w} 0 v${h - 12} a${w / 2} 6 0 0 1 ${-w} 0 Z`,
  rim: `M${x} ${y + 6} a${w / 2} 6 0 0 0 ${w} 0`,
});

/** 两点之间的竖向 S 形曲线。 */
const vcurve = (x1: number, y1: number, x2: number, y2: number) => {
  const my = (y1 + y2) / 2;
  return `M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2}`;
};

/** 两点之间的横向 S 形曲线。 */
const hcurve = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`;
};

const d = (ms: number) => `--d:${ms}ms`;

const T = {
  zh: {
    origins: {
      title: '查询经由全局模式与映射到达数据源',
      caption:
        '用户只面对本体（全局模式）提问；查询先按本体公理改写，再沿映射展开为各数据源上的 SQL。数据始终留在原来的系统中。',
      ontology: '本体 · 全局模式',
      mapping: '映射（GAV）',
      sources: ['教务系统', '图书馆', '人事系统'],
      rewrite: '改写',
      unfold: '展开为 SQL',
    },
    systems: {
      title: 'T-mappings：把本体编进映射',
      caption:
        '离线把子类公理编进映射：student 与 teacher 两张表直接映射到 :Person。查询 :Person 时不再需要在线改写，得到的 SQL 是两张表的并。',
      tables: '数据库表',
      classes: '本体中的类',
      compiled: '离线编译',
    },
    industry: {
      title: '多种数据源汇入同一张图',
      caption:
        '关系库、文档库、空间库、数据湖与数据流各有映射，汇入同一张虚拟知识图谱；同一实体在两个源中的记录经 owl:sameAs 或规范 IRI 合并为一个节点。',
      graph: '虚拟知识图谱',
      ontology: '本体',
      sources: ['关系库', 'MongoDB', '空间库', '数据湖', '数据流'],
      merged: '同一实体，合并为一个节点',
    },
    federation: {
      title: '联邦引擎之上的 OBDA 与 lens 视图层',
      caption:
        'Ontop 把 SPARQL 改写为一条 SQL，交给联邦引擎；联邦引擎再拆成各个数据源上的查询。lens 在 Ontop 内定义视图，补充数据库没有声明的约束。',
      layers: ['本体', '映射', 'Lens 视图层', '联邦引擎（Trino / Dremio / Denodo）'],
      sources: ['PostgreSQL', 'Oracle', 'Parquet', 'MongoDB'],
      toSql: 'SPARQL → 一条 SQL',
      fanOut: '拆分到各数据源',
    },
    now: {
      title: '可写回的 VKG 与大模型协助演化',
      caption:
        '左：SPARQL Update 沿映射求逆，翻译为数据源上的 SQL，新行写入源表。右：大语言模型为新的信息需求提出本体元素与映射，经 SPARQL 执行反馈检验后加入。',
      writeTitle: '经由 VKG 写回',
      read: '读',
      write: '写',
      invert: '映射求逆',
      llmTitle: '大模型提出扩展',
      need: '新需求：合同有哪些？',
      check: 'SPARQL 执行反馈通过',
    },
  },
  en: {
    origins: {
      title: 'Queries reach the sources through a global schema and mappings',
      caption:
        'Users ask questions over the ontology (the global schema) only; a query is first rewritten with the ontology axioms and then unfolded along the mappings into SQL over each source. The data never leaves its systems.',
      ontology: 'Ontology · global schema',
      mapping: 'Mappings (GAV)',
      sources: ['Registrar', 'Library', 'HR'],
      rewrite: 'rewrite',
      unfold: 'unfold into SQL',
    },
    systems: {
      title: 'T-mappings: compiling the ontology into the mappings',
      caption:
        'The subclass axioms are compiled into the mappings offline, so the student and teacher tables map directly to :Person. A query for :Person needs no online rewriting, and its SQL is the union of the two tables.',
      tables: 'Database tables',
      classes: 'Ontology classes',
      compiled: 'compiled offline',
    },
    industry: {
      title: 'Many kinds of sources feed one graph',
      caption:
        'Relational and document databases, spatial databases, data lakes and streams each have mappings into one virtual knowledge graph; records of the same entity in two sources merge into one node through owl:sameAs or canonical IRIs.',
      graph: 'Virtual knowledge graph',
      ontology: 'Ontology',
      sources: ['Relational', 'MongoDB', 'Spatial', 'Data lake', 'Streams'],
      merged: 'same entity, merged into one node',
    },
    federation: {
      title: 'OBDA over a federation engine, with a lens layer',
      caption:
        'Ontop rewrites SPARQL into a single SQL query for the federation engine, which splits it into queries over each source. Lenses define views inside Ontop and declare constraints the databases do not.',
      layers: ['Ontology', 'Mappings', 'Lens layer', 'Federation engine (Trino / Dremio / Denodo)'],
      sources: ['PostgreSQL', 'Oracle', 'Parquet', 'MongoDB'],
      toSql: 'SPARQL → one SQL query',
      fanOut: 'split across the sources',
    },
    now: {
      title: 'Writable VKGs and LLM-assisted evolution',
      caption:
        'Left: a SPARQL Update is translated back through the mappings into SQL over the sources, and a new row is written to the source table. Right: a language model proposes ontology elements and mappings for a new information need, which are added after SPARQL execution feedback confirms them.',
      writeTitle: 'Writing back through a VKG',
      read: 'read',
      write: 'write',
      invert: 'invert mappings',
      llmTitle: 'An LLM proposes an extension',
      need: 'New need: which contracts exist?',
      check: 'SPARQL execution feedback passes',
    },
  },
}[lang];

const t = T[era];
---

<figure class="fig" data-reveal>
  <figcaption class="fig-title">{t.title}</figcaption>
  <div class="fig-canvas">
    {era === 'origins' &&
      (() => {
        const s = T.origins;
        const sources = [120, 280, 440];
        const classes = [
          { x: 150, label: ':Student' },
          { x: 280, label: ':Person' },
          { x: 410, label: ':Teacher' },
        ];
        // 教务→Student，图书馆→Person，人事→Teacher
        const mapTo = [0, 1, 2];
        return (
          <svg viewBox="0 0 560 300" role="img" aria-label={s.caption}>
            <g class="a" style={d(900)}>
              <rect class="pill" x="200" y="12" width="160" height="28" rx="14" />
              <text class="t-mono t-code" x="280" y="31" text-anchor="middle">
                ?x a :Person
              </text>
            </g>
            <path class="ln ln-query draw" d="M280 40 V70" pathLength="1" style={d(1100)} />
            <g class="a" style={d(500)}>
              <rect class="box box-onto" x="70" y="70" width="420" height="58" rx="12" />
              <text class="t-sm" x="84" y="88">
                {s.ontology}
              </text>
            </g>
            {classes.map((c, i) => (
              <g class="a" style={d(600 + i * 90)}>
                <rect class="chip chip-onto" x={c.x - 46} y="96" width="92" height="22" rx="11" />
                <text class="t-mono" x={c.x} y="111" text-anchor="middle">
                  {c.label}
                </text>
              </g>
            ))}
            <path class="ln ln-sub draw" d="M196 107 H234" pathLength="1" style={d(900)} />
            <path class="ln ln-sub draw" d="M364 107 H326" pathLength="1" style={d(950)} />
            <text class="t-sm a" x="84" y="160" style={d(700)}>
              {s.mapping}
            </text>
            {sources.map((x, i) => {
              const target = classes[mapTo[i]].x;
              return (
                <path
                  class="ln ln-map draw"
                  d={vcurve(x, 218, target, 120)}
                  pathLength="1"
                  style={d(400 + i * 120)}
                />
              );
            })}
            {sources.map((x, i) => {
              const target = classes[mapTo[i]].x;
              return <path class="ln ln-flow" d={vcurve(target, 120, x, 218)} style={d(1400)} />;
            })}
            {sources.map((x, i) => {
              const c = cylinder(x - 34, 218, 68, 44);
              return (
                <g class="a" style={d(i * 120)}>
                  <path class="db" d={c.body} />
                  <path class="db-rim" d={c.rim} />
                  <text class="t" x={x} y="284" text-anchor="middle">
                    {s.sources[i]}
                  </text>
                </g>
              );
            })}
            <text class="t-note a" x="300" y="60" style={d(1200)}>
              {s.rewrite}
            </text>
            <text class="t-note a" x="490" y="170" text-anchor="end" style={d(1400)}>
              {s.unfold}
            </text>
          </svg>
        );
      })()}
    {era === 'systems' &&
      (() => {
        const s = T.systems;
        const tables = [
          { name: 'student', y: 52, rows: ['1 · Lin Xiao', '2 · Zhou Ning'] },
          { name: 'teacher', y: 172, rows: ['1 · Prof. Chen'] },
        ];
        const cls = {
          student: { x: 440, y: 64, label: ':Student' },
          person: { x: 500, y: 140, label: ':Person' },
          teacher: { x: 440, y: 216, label: ':Teacher' },
        };
        return (
          <svg viewBox="0 0 560 300" role="img" aria-label={s.caption}>
            <text class="t-sm" x="30" y="30">
              {s.tables}
            </text>
            <text class="t-sm" x="530" y="30" text-anchor="end">
              {s.classes}
            </text>
            {tables.map((tb, i) => (
              <g class="a" style={d(i * 120)}>
                <rect
                  class="box"
                  x="30"
                  y={tb.y}
                  width="150"
                  height={30 + tb.rows.length * 24}
                  rx="8"
                />
                <text class="t-mono t-strong" x="44" y={tb.y + 20}>
                  {tb.name}
                </text>
                {tb.rows.map((row, j) => (
                  <text class="t-mono t-faint" x="44" y={tb.y + 46 + j * 24}>
                    {row}
                  </text>
                ))}
              </g>
            ))}
            <path
              class="ln ln-map draw"
              d={hcurve(180, 70, cls.student.x - 46, cls.student.y)}
              pathLength="1"
              style={d(300)}
            />
            <path
              class="ln ln-map draw"
              d={hcurve(180, 190, cls.teacher.x - 46, cls.teacher.y)}
              pathLength="1"
              style={d(400)}
            />
            {Object.values(cls).map((c, i) => (
              <g class="a" style={d(200 + i * 100)}>
                <rect
                  class:list={['chip', i === 1 ? 'chip-person' : 'chip-onto']}
                  x={c.x - 46}
                  y={c.y - 12}
                  width="92"
                  height="24"
                  rx="12"
                />
                <text class="t-mono" x={c.x} y={c.y + 4} text-anchor="middle">
                  {c.label}
                </text>
              </g>
            ))}
            <path
              class="ln ln-sub draw"
              d={vcurve(cls.student.x + 20, cls.student.y + 12, cls.person.x, cls.person.y - 12)}
              pathLength="1"
              style={d(700)}
            />
            <path
              class="ln ln-sub draw"
              d={vcurve(cls.teacher.x + 20, cls.teacher.y - 12, cls.person.x, cls.person.y + 12)}
              pathLength="1"
              style={d(780)}
            />
            <g class="a" style={d(1100)}>
              <rect
                class="badge"
                x={lang === 'zh' ? 246 : 230}
                y="126"
                width={lang === 'zh' ? 104 : 136}
                height="26"
                rx="13"
              />
              <text class="t-badge" x="298" y="143" text-anchor="middle">
                ⚙ {s.compiled}
              </text>
            </g>
            <path
              class="ln ln-new draw"
              d={hcurve(180, 82, cls.person.x - 46, cls.person.y - 4)}
              pathLength="1"
              style={d(1300)}
            />
            <path
              class="ln ln-new draw"
              d={hcurve(180, 202, cls.person.x - 46, cls.person.y + 4)}
              pathLength="1"
              style={d(1420)}
            />
            <path
              class="ln ln-flow ln-flow-new"
              d={hcurve(180, 82, cls.person.x - 46, cls.person.y - 4)}
              style={d(2000)}
            />
            <path
              class="ln ln-flow ln-flow-new"
              d={hcurve(180, 202, cls.person.x - 46, cls.person.y + 4)}
              style={d(2000)}
            />
            <g class="a" style={d(1800)}>
              <rect class="code" x="30" y="252" width="500" height="34" rx="8" />
              <text class="t-mono t-code" x="46" y="274">
                <tspan class="k">SELECT</tspan> name <tspan class="k">FROM</tspan> student{' '}
                <tspan class="k">UNION ALL</tspan> <tspan class="k">SELECT</tspan> name{' '}
                <tspan class="k">FROM</tspan> teacher
              </text>
            </g>
          </svg>
        );
      })()}
    {era === 'industry' &&
      (() => {
        const s = T.industry;
        const xs = [70, 175, 280, 385, 490];
        // 图中的实体：前两个源各有一条记录，指向同一实体
        const nodes = [
          { x: 230, y: 52 },
          { x: 330, y: 58 },
          { x: 410, y: 78 },
        ];
        return (
          <svg viewBox="0 0 560 300" role="img" aria-label={s.caption}>
            <g class="a" style={d(700)}>
              <rect class="box box-graph" x="40" y="18" width="480" height="96" rx="14" />
              <text class="t-sm" x="54" y="36">
                {s.graph}
              </text>
            </g>
            <g class="a" style={d(900)}>
              <path
                class="ln ln-edge"
                d="M110 84 L230 52 L330 58 L410 78 M330 58 L300 96 M230 52 L300 96"
              />
            </g>
            {nodes.map((n, i) => (
              <circle class="node a" cx={n.x} cy={n.y} r="7" style={d(950 + i * 80)} />
            ))}
            <circle class="node node-b a" cx="300" cy="96" r="7" style={d(1200)} />
            <g class="merge">
              <circle class="node node-a" cx="78" cy="84" r="8" />
              <circle class="node node-a node-a2" cx="142" cy="84" r="8" />
            </g>
            <text class="t-note a" x="126" y="104" style={d(2200)}>
              {s.merged}
            </text>
            <g class="a" style={d(500)}>
              <rect class="band" x="40" y="132" width="480" height="22" rx="11" />
              <text class="t-sm" x="280" y="147" text-anchor="middle">
                {s.ontology}
              </text>
            </g>
            {xs.map((x, i) => {
              const target = [110, 110, 300, 330, 410][i];
              const ty = i < 2 ? 92 : i === 2 ? 104 : i === 3 ? 66 : 86;
              return (
                <>
                  <path
                    class="ln ln-map draw"
                    d={vcurve(x, 214, target, ty)}
                    pathLength="1"
                    style={d(300 + i * 110)}
                  />
                  <path class="ln ln-flow" d={vcurve(target, ty, x, 214)} style={d(1600)} />
                </>
              );
            })}
            {xs.map((x, i) => (
              <g class="a src" style={d(i * 110)}>
                {i === 0 && <path class="db" d={cylinder(x - 26, 214, 52, 40).body} />}
                {i === 0 && <path class="db-rim" d={cylinder(x - 26, 214, 52, 40).rim} />}
                {i === 1 && (
                  <>
                    <rect class="db" x={x - 22} y="214" width="44" height="40" rx="6" />
                    <text class="t-mono t-faint" x={x} y="239" text-anchor="middle">
                      {'{ }'}
                    </text>
                  </>
                )}
                {i === 2 && (
                  <>
                    <circle class="db" cx={x} cy="234" r="20" />
                    <path
                      class="db-rim"
                      d={`M${x - 20} 234 H${x + 20} M${x} 214 C${x - 12} 226 ${x - 12} 242 ${x} 254 M${x} 214 C${x + 12} 226 ${x + 12} 242 ${x} 254`}
                    />
                  </>
                )}
                {i === 3 && (
                  <>
                    <rect class="db" x={x - 24} y="226" width="48" height="28" rx="4" />
                    <rect class="db" x={x - 20} y="220" width="40" height="8" rx="3" />
                    <rect class="db" x={x - 16} y="214" width="32" height="8" rx="3" />
                  </>
                )}
                {i === 4 && (
                  <path
                    class="db-rim db-wave"
                    d={`M${x - 26} 228 q6.5 -10 13 0 t13 0 t13 0 t13 0 M${x - 26} 242 q6.5 -10 13 0 t13 0 t13 0 t13 0`}
                  />
                )}
                <text class="t" x={x} y="280" text-anchor="middle">
                  {s.sources[i]}
                </text>
              </g>
            ))}
          </svg>
        );
      })()}
    {era === 'federation' &&
      (() => {
        const s = T.federation;
        const layers = [
          { y: 54, cls: 'box-onto' },
          { y: 96, cls: 'box-map' },
          { y: 138, cls: 'box-lens' },
          { y: 180, cls: 'box-fed' },
        ];
        const xs = [110, 230, 350, 470];
        return (
          <svg viewBox="0 0 560 300" role="img" aria-label={s.caption}>
            <g class="a" style={d(900)}>
              <rect class="pill" x="230" y="10" width="100" height="26" rx="13" />
              <text class="t-mono t-code" x="280" y="28" text-anchor="middle">
                SPARQL
              </text>
            </g>
            {layers.map((layer, i) => (
              <g class="a a-rise" style={d(500 - i * 110)}>
                <rect
                  class:list={['box', layer.cls]}
                  x="70"
                  y={layer.y}
                  width="420"
                  height="32"
                  rx="10"
                />
                <text class="t" x="86" y={layer.y + 21}>
                  {s.layers[i]}
                </text>
              </g>
            ))}
            <g class="a" style={d(650)}>
              <rect class="chip chip-lens" x="330" y="144" width="60" height="20" rx="6" />
              <text class="t-mono" x="360" y="158" text-anchor="middle">
                view₁
              </text>
              <rect class="chip chip-lens" x="400" y="144" width="60" height="20" rx="6" />
              <text class="t-mono" x="430" y="158" text-anchor="middle">
                view₂
              </text>
            </g>
            <path class="ln ln-beam draw" d="M280 36 V180" pathLength="1" style={d(1100)} />
            <path class="ln ln-flow" d="M280 36 V180" style={d(1700)} />
            <text class="t-note a" x="292" y="50" style={d(1300)}>
              {s.toSql}
            </text>
            {xs.map((x, i) => (
              <>
                <path
                  class="ln ln-map draw"
                  d={vcurve(280, 212, x, 238)}
                  pathLength="1"
                  style={d(1500 + i * 80)}
                />
                <path class="ln ln-flow" d={vcurve(280, 212, x, 238)} style={d(2000)} />
              </>
            ))}
            {xs.map((x, i) => {
              const c = cylinder(x - 28, 238, 56, 34);
              return (
                <g class="a" style={d(i * 90)}>
                  <path class="db" d={c.body} />
                  <path class="db-rim" d={c.rim} />
                  <text class="t-sm" x={x} y="290" text-anchor="middle">
                    {s.sources[i]}
                  </text>
                </g>
              );
            })}
            <text class="t-note a" x="24" y="226" style={d(1800)}>
              {s.fanOut}
            </text>
          </svg>
        );
      })()}
    {era === 'now' &&
      (() => {
        const s = T.now;
        return (
          <svg viewBox="0 0 560 300" role="img" aria-label={s.caption}>
            <text class="t-sm" x="20" y="22">
              {s.writeTitle}
            </text>
            <g class="a" style={d(200)}>
              <rect class="pill pill-write" x="20" y="34" width="250" height="40" rx="10" />
              <text class="t-mono t-code" x="34" y="52">
                <tspan class="k">INSERT DATA</tspan> {'{'}
              </text>
              <text class="t-mono t-code" x="46" y="67">
                :p7 :worksFor :c2 {'}'}
              </text>
            </g>
            <g class="a" style={d(500)}>
              <rect class="box box-map" x="20" y="112" width="250" height="34" rx="10" />
              <text class="t" x="34" y="134">
                {s.invert}
              </text>
            </g>
            <path class="ln ln-write draw" d="M118 74 V112" pathLength="1" style={d(700)} />
            <path class="ln ln-write draw" d="M118 146 V184" pathLength="1" style={d(1100)} />
            <path class="ln ln-read" d="M178 184 V146 M178 112 V74" />
            <text class="t-note a" x="126" y="98" style={d(800)}>
              {s.write} ↓
            </text>
            <text class="t-note t-faint a" x="186" y="98" style={d(800)}>
              ↑ {s.read}
            </text>
            <g class="a" style={d(900)}>
              <rect class="box" x="20" y="184" width="250" height="96" rx="8" />
              <text class="t-mono t-strong" x="34" y="204">
                employment
              </text>
              <text class="t-mono t-faint" x="34" y="228">
                p1 · c1
              </text>
              <text class="t-mono t-faint" x="34" y="248">
                p4 · c2
              </text>
            </g>
            <g class="new-row">
              <rect class="row-hl" x="26" y="256" width="238" height="20" rx="4" />
              <text class="t-mono" x="34" y="270">
                <tspan class="k">+</tspan> p7 · c2
              </text>
            </g>

            <line class="divider" x1="296" y1="20" x2="296" y2="280" />

            <text class="t-sm" x="316" y="22">
              {s.llmTitle}
            </text>
            <g class="a" style={d(300)}>
              <rect class="pill pill-need" x="316" y="34" width="224" height="28" rx="14" />
              <text class="t" x="428" y="53" text-anchor="middle">
                {s.need}
              </text>
            </g>
            <g class="a" style={d(500)}>
              <path class="ln ln-edge" d="M360 130 L430 104 L500 136 M430 104 L430 170" />
              <circle class="node" cx="360" cy="130" r="7" />
              <circle class="node" cx="430" cy="104" r="7" />
              <circle class="node" cx="500" cy="136" r="7" />
            </g>
            <g class="a" style={d(900)}>
              <rect class="badge badge-llm" x="320" y="74" width="54" height="22" rx="11" />
              <text class="t-badge" x="347" y="89" text-anchor="middle">
                ✦ LLM
              </text>
            </g>
            <g class="ghost">
              <path class="ln ln-ghost" d="M430 111 V163" />
              <rect class="chip chip-ghost" x="384" y="163" width="92" height="24" rx="12" />
              <text class="t-mono" x="430" y="179" text-anchor="middle">
                :Contract
              </text>
              <path class="ln ln-ghost" d={vcurve(430, 187, 430, 228)} />
              <rect class="box box-ghost" x="384" y="228" width="92" height="30" rx="6" />
              <text class="t-mono" x="430" y="247" text-anchor="middle">
                contracts
              </text>
            </g>
            <g class="check">
              <circle class="check-dot" cx="500" cy="200" r="11" />
              <path class="check-mark" d="M494 200 l4 4 l8 -9" />
              <text class="t-note" x="540" y="284" text-anchor="end">
                {s.check}
              </text>
            </g>
          </svg>
        );
      })()}
  </div>
  <p class="fig-caption">{t.caption}</p>
</figure>

<style>
  .fig {
    --c-onto: var(--code-var);
    --c-map: var(--accent);
    --c-new: var(--lane-3, #7fd38a);
    --c-llm: var(--lane-4, #f29fb8);
    margin-top: 22px;
    padding: 18px 20px 16px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background:
      radial-gradient(600px 240px at 100% 0%, var(--accent-soft), transparent 60%), var(--surface);
  }

  .fig-title {
    font-size: 14px;
    font-weight: 650;
    color: var(--ink);
  }

  .fig-caption {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* 窄屏下保持可读的字号，横向滚动查看 */
  .fig-canvas {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  svg {
    display: block;
    width: 100%;
    min-width: 500px;
    max-width: 620px;
    height: auto;
    margin: 6px auto 0;
    overflow: visible;
  }

  /* 文字 */
  .t,
  .t-sm,
  .t-note,
  .t-badge {
    font-family: var(--font-sans);
  }

  .t {
    font-size: 12.5px;
    fill: var(--ink-2);
  }

  .t-sm {
    font-size: 11.5px;
    fill: var(--faint);
  }

  .t-note {
    font-size: 11.5px;
    font-style: italic;
    fill: var(--accent-ink);
  }

  .t-mono {
    font: 12px var(--font-mono);
    fill: var(--ink);
  }

  .t-code {
    fill: var(--code-ink);
  }

  .t-strong {
    font-weight: 600;
    fill: var(--accent-ink);
  }

  .t-faint {
    fill: var(--muted);
  }

  .k {
    fill: var(--code-kw);
  }

  .t-badge {
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--ink);
  }

  /* 图形 */
  .box {
    fill: var(--surface-2);
    stroke: var(--line-strong);
  }

  .box-onto {
    fill: color-mix(in srgb, var(--c-onto) 7%, var(--surface));
    stroke: color-mix(in srgb, var(--c-onto) 45%, transparent);
  }

  .box-graph {
    fill: color-mix(in srgb, var(--c-map) 6%, var(--surface));
    stroke: color-mix(in srgb, var(--c-map) 35%, transparent);
  }

  .box-map {
    fill: color-mix(in srgb, var(--c-map) 8%, var(--surface));
    stroke: color-mix(in srgb, var(--c-map) 40%, transparent);
  }

  .box-lens {
    fill: color-mix(in srgb, var(--c-new) 8%, var(--surface));
    stroke: color-mix(in srgb, var(--c-new) 45%, transparent);
  }

  .box-fed {
    fill: var(--surface-2);
    stroke: var(--line-strong);
  }

  .band {
    fill: color-mix(in srgb, var(--c-onto) 10%, var(--surface));
    stroke: color-mix(in srgb, var(--c-onto) 40%, transparent);
  }

  .pill {
    fill: var(--code-bg);
    stroke: color-mix(in srgb, var(--c-map) 55%, transparent);
  }

  .pill-need {
    fill: color-mix(in srgb, var(--c-llm) 10%, var(--surface));
    stroke: color-mix(in srgb, var(--c-llm) 50%, transparent);
  }

  .code {
    fill: var(--code-bg);
    stroke: var(--line);
  }

  .chip {
    stroke-width: 1.2;
  }

  .chip-onto {
    fill: color-mix(in srgb, var(--c-onto) 14%, var(--surface));
    stroke: color-mix(in srgb, var(--c-onto) 60%, transparent);
  }

  .chip-person {
    fill: color-mix(in srgb, var(--c-new) 16%, var(--surface));
    stroke: var(--c-new);
  }

  .chip-lens {
    fill: color-mix(in srgb, var(--c-new) 14%, var(--surface));
    stroke: color-mix(in srgb, var(--c-new) 55%, transparent);
  }

  .badge {
    fill: color-mix(in srgb, var(--c-new) 16%, var(--surface));
    stroke: var(--c-new);
  }

  .badge-llm {
    fill: color-mix(in srgb, var(--c-llm) 16%, var(--surface));
    stroke: var(--c-llm);
  }

  .db {
    fill: var(--surface-2);
    stroke: color-mix(in srgb, var(--ink) 35%, transparent);
    stroke-width: 1.2;
  }

  .db-rim {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 35%, transparent);
    stroke-width: 1.2;
  }

  .db-wave {
    stroke: var(--c-map);
    stroke-width: 2;
  }

  .node {
    fill: var(--c-map);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .node-a {
    fill: var(--c-new);
  }

  .node-b {
    fill: var(--c-onto);
  }

  .divider {
    stroke: var(--line);
    stroke-dasharray: 3 5;
  }

  /* 连线 */
  .ln {
    fill: none;
    stroke-width: 1.5;
  }

  .ln-map {
    stroke: color-mix(in srgb, var(--c-map) 70%, transparent);
  }

  .ln-query,
  .ln-beam {
    stroke: var(--c-map);
    stroke-width: 2;
  }

  .ln-sub {
    stroke: var(--c-onto);
    stroke-dasharray: 0.04 0.03;
  }

  .ln-new {
    stroke: var(--c-new);
    stroke-width: 2;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-new) 60%, transparent));
  }

  .ln-edge {
    stroke: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .ln-write {
    stroke: var(--c-llm);
    stroke-width: 2;
  }

  .ln-read {
    stroke: color-mix(in srgb, var(--c-map) 50%, transparent);
    stroke-dasharray: 3 4;
  }

  .ln-ghost {
    stroke: var(--c-llm);
    stroke-dasharray: 4 4;
  }

  .ln-flow {
    stroke: var(--c-map);
    stroke-width: 2;
    stroke-dasharray: 3 12;
    opacity: 0;
  }

  .ln-flow-new {
    stroke: var(--c-new);
  }

  /* ── 动画：进入视口后依次出现，之后连线上保留流动 ── */
  :global(.js) .a,
  :global(.js) .merge,
  :global(.js) .ghost,
  :global(.js) .check,
  :global(.js) .new-row {
    opacity: 0;
  }

  :global(.js) .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.js) .ln-sub.draw {
    stroke-dasharray: 0.04 0.03;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  .fig:global(.is-revealed) .a {
    animation: appear 0.6s var(--ease) var(--d, 0ms) both;
  }

  .fig:global(.is-revealed) .a-rise {
    animation-name: rise;
  }

  .fig:global(.is-revealed) .draw {
    animation: draw 0.9s var(--ease) var(--d, 0ms) forwards;
  }

  .fig:global(.is-revealed) .ln-sub.draw {
    animation: fade 0.6s var(--ease) var(--d, 0ms) forwards;
  }

  .fig:global(.is-revealed) .ln-flow {
    animation:
      fade 0.4s var(--d, 0ms) forwards,
      flow 1.8s linear var(--d, 0ms) infinite;
  }

  /* 两个源中的同一实体：先分开出现，再合并 */
  .fig:global(.is-revealed) .merge {
    animation: fade 0.5s 900ms forwards;
  }

  .fig:global(.is-revealed) .node-a {
    animation: merge-left 0.9s var(--ease) 1700ms forwards;
  }

  .fig:global(.is-revealed) .node-a2 {
    animation-name: merge-right;
  }

  /* 写回：新行滑入 */
  .fig:global(.is-revealed) .new-row {
    animation: slide-in 0.6s var(--ease) 1500ms forwards;
  }

  .row-hl {
    fill: color-mix(in srgb, var(--c-llm) 18%, transparent);
    stroke: color-mix(in srgb, var(--c-llm) 55%, transparent);
  }

  /* 大模型的提议：先以虚线出现，检验通过后变为实线 */
  .fig:global(.is-revealed) .ghost {
    animation:
      fade 0.6s 1100ms forwards,
      solidify 0.6s 2300ms forwards;
  }

  .chip-ghost {
    fill: color-mix(in srgb, var(--c-llm) 10%, var(--surface));
    stroke: var(--c-llm);
    stroke-dasharray: 4 3;
  }

  .box-ghost {
    fill: var(--surface-2);
    stroke: var(--c-llm);
    stroke-dasharray: 4 3;
  }

  .fig:global(.is-revealed) .ghost .chip-ghost,
  .fig:global(.is-revealed) .ghost .box-ghost,
  .fig:global(.is-revealed) .ghost .ln-ghost {
    animation: dash-to-solid 0.01s 2300ms forwards;
  }

  .fig:global(.is-revealed) .check {
    animation: appear 0.5s var(--ease) 2100ms forwards;
  }

  .check-dot {
    fill: var(--c-new);
  }

  .check-mark {
    fill: none;
    stroke: var(--surface);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -30;
    }
  }

  @keyframes merge-left {
    to {
      transform: translateX(32px);
    }
  }

  @keyframes merge-right {
    to {
      transform: translateX(-32px);
    }
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes solidify {
    to {
      opacity: 1;
    }
  }

  @keyframes dash-to-solid {
    to {
      stroke-dasharray: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .a,
    :global(.js) .merge,
    :global(.js) .ghost,
    :global(.js) .check,
    :global(.js) .new-row {
      opacity: 1;
    }

    :global(.js) .draw {
      stroke-dashoffset: 0;
    }

    :global(.js) .ln-sub.draw {
      opacity: 1;
    }

    .fig:global(.is-revealed) * {
      animation: none !important;
    }

    .node-a {
      transform: translateX(32px);
    }

    .node-a2 {
      transform: translateX(-32px);
    }

    .ln-flow {
      opacity: 0.6;
    }
  }
</style>
