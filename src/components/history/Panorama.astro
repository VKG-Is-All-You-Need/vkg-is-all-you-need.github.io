---
/**
 * 发展历程的全景泳道图：横轴为年份，五条泳道，节点之间的连线表示传承关系。
 * 布局在构建时计算；进入视口后的扫描动画、悬停高亮与提示卡片见 scripts/history.ts。
 */
import { ERAS, LANES, LINKS, MILESTONES, YEAR_FROM, YEAR_TO } from '../../data/history';
import { langOf, localize } from '../../i18n';

const lang = langOf(Astro.url.pathname);

const PX_PER_YEAR = 88;
const PAD_LEFT = 28;
const PAD_RIGHT = 170;
const AXIS_H = 44;
const ROW_H = 30;
const LANE_PAD = 22;

const xOf = (year: number) => PAD_LEFT + (year - YEAR_FROM) * PX_PER_YEAR;
const width = xOf(YEAR_TO) + PAD_RIGHT;

/** 估算标签宽度：中日韩字符按 13px，其余按 7px（主要节点略宽）。 */
const labelWidth = (text: string, major: boolean) =>
  [...text].reduce((w, c) => w + (/[　-鿿]/.test(c) ? 13 : 7), 0) * (major ? 1.12 : 1) +
  (major ? 26 : 20);

// 每条泳道内把节点分到若干行，避免标签重叠
const placed = new Map<string, { x: number; y: number; row: number }>();
let top = AXIS_H;
const lanes = LANES.map((lane) => {
  const items = MILESTONES.filter((m) => m.lane === lane.id).sort(
    (a, b) => a.year - b.year || Number(Boolean(b.major)) - Number(Boolean(a.major)),
  );
  const rowEnds: number[] = [];
  const rows = items.map((m) => {
    const x = xOf(m.year);
    let row = rowEnds.findIndex((end) => end + 10 < x);
    if (row < 0) row = rowEnds.length;
    rowEnds[row] = x + labelWidth(m.label[lang], Boolean(m.major));
    return { m, x, row };
  });
  const height = LANE_PAD * 2 + Math.max(1, rowEnds.length) * ROW_H;
  const laneTop = top;
  for (const { m, x, row } of rows) {
    placed.set(m.id, { x, y: laneTop + LANE_PAD + ROW_H / 2 + row * ROW_H, row });
  }
  top += height;
  return { ...lane, top: laneTop, height };
});
const height = top + 12;

const nodes = MILESTONES.map((m) => ({ ...m, ...placed.get(m.id)! }));
const nodeById = new Map(nodes.map((n) => [n.id, n]));

const links = LINKS.map(([from, to, kind]) => {
  const a = nodeById.get(from)!;
  const b = nodeById.get(to)!;
  const dx = Math.max(b.x - a.x, 40);
  const d = `M${a.x} ${a.y} C${a.x + dx * 0.5} ${a.y} ${b.x - dx * 0.5} ${b.y} ${b.x} ${b.y}`;
  return { from, to, kind, d };
});

const years = Array.from({ length: YEAR_TO - YEAR_FROM + 1 }, (_, i) => YEAR_FROM + i);

const t = {
  zh: {
    label:
      '发展全景：横轴为年份，五条泳道分别是范式与名称、系统与产业、理论标准与基准、多源与时空数据、演化更新与大模型。',
    cite: '明确的传承',
    thread: '同一问题线',
    major: '主要里程碑',
    hint: '悬停或点击节点查看出处 · 横向拖动查看全部年份',
    replay: '重放',
  },
  en: {
    label:
      'Panorama of the field: years on the horizontal axis and five lanes for paradigms, systems and industry, theory and standards, sources in time and space, and evolution, updates and LLMs.',
    cite: 'Builds on',
    thread: 'Same line of work',
    major: 'Major milestone',
    hint: 'Hover or tap a node for its source · Drag sideways to see all years',
    replay: 'Replay',
  },
}[lang];
---

<figure class="panorama" data-panorama>
  <div class="panorama-frame">
    <ol class="lane-labels" aria-hidden="true">
      {lanes.map((lane, i) => (
        <li style={`top:${lane.top}px;height:${lane.height}px;--lane:var(--lane-${i})`}>
          <span>{lane.label[lang]}</span>
        </li>
      ))}
    </ol>
    <div class="panorama-scroll" data-panorama-scroll tabindex="0" aria-label={t.label}>
      <svg
        width={width}
        height={height}
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-label={t.label}
        data-panorama-svg
      >
        <defs>
          <linearGradient id="cursor-glow" x1="0" x2="1">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0.22"></stop>
          </linearGradient>
        </defs>

        <g class="eras">
          {ERAS.map((era, i) => {
            const x0 = xOf(era.from) - PX_PER_YEAR / 2;
            const x1 = xOf(era.to) + PX_PER_YEAR / 2;
            return (
              <g class:list={['era', { 'era-alt': i % 2 }]} data-era={era.id}>
                <rect x={x0} y={0} width={x1 - x0} height={height} />
                <text x={Math.max(x0 + 10, 8)} y={18}>
                  {`${'①②③④⑤'[i]} ${era.title[lang]}`}
                </text>
              </g>
            );
          })}
        </g>

        <g class="lanes">
          {lanes.map((lane) => (
            <line x1="0" x2={width} y1={lane.top + lane.height} y2={lane.top + lane.height} />
          ))}
        </g>

        <g class="axis">
          {years.map((year) => (
            <g class:list={['tick', { 'tick-major': year % 5 === 0 }]}>
              <line x1={xOf(year)} x2={xOf(year)} y1={AXIS_H - 8} y2={height} />
              <text x={xOf(year)} y={AXIS_H - 14}>
                {year % 2 === 0 || year === YEAR_TO ? year : `'${String(year).slice(2)}`}
              </text>
            </g>
          ))}
        </g>

        <rect
          class="cursor-trail"
          x="0"
          y={AXIS_H}
          width="0"
          height={height - AXIS_H}
          fill="url(#cursor-glow)"
          data-cursor-trail
        />
        <line class="cursor" x1="0" x2="0" y1={AXIS_H - 6} y2={height} data-cursor />

        <g class="links">
          {links.map((link) => (
            <g class:list={['link', `link-${link.kind}`]} data-from={link.from} data-to={link.to}>
              <path
                class="link-base"
                d={link.d}
                pathLength={link.kind === 'cite' ? 1 : undefined}
              />
              <path class="link-flow" d={link.d} />
            </g>
          ))}
        </g>

        <g class="nodes">
          {nodes.map((node) => {
            const lane = LANES.findIndex((l) => l.id === node.lane);
            return (
              <g
                class:list={['node', { 'node-major': node.major }]}
                style={`--lane:var(--lane-${lane})`}
                data-node={node.id}
                data-x={node.x}
                tabindex="0"
                role="button"
                aria-label={`${node.year} ${node.label[lang]}`}
              >
                <circle class="node-halo" cx={node.x} cy={node.y} r={node.major ? 15 : 11} />
                <circle class="node-dot" cx={node.x} cy={node.y} r={node.major ? 7 : 5} />
                <text x={node.x + (node.major ? 13 : 10)} y={node.y + 4.5}>
                  {node.label[lang]}
                </text>
              </g>
            );
          })}
        </g>
      </svg>
      <div class="tip" data-panorama-tip hidden></div>
    </div>
  </div>
  <figcaption class="panorama-legend">
    <span>
      <i class="key key-cite"></i>
      {t.cite}
    </span>
    <span>
      <i class="key key-thread"></i>
      {t.thread}
    </span>
    <span>
      <i class="key key-major"></i>
      {t.major}
    </span>
    <span class="legend-hint">{t.hint}</span>
    <button type="button" class="replay" data-panorama-replay>
      {t.replay}
    </button>
  </figcaption>
  <script
    type="application/json"
    data-panorama-data
    set:html={JSON.stringify(
      Object.fromEntries(
        MILESTONES.map((m) => [
          m.id,
          {
            year: m.year,
            label: m.label[lang],
            text: m.text[lang],
            cite: m.cite,
            href: m.paper ? localize(`/papers/#${m.paper}`, lang) : m.url,
            external: !m.paper,
          },
        ]),
      ),
    ).replaceAll('<', '\\u003c')}
  />
</figure>

<style>
  .panorama {
    --lane-0: #49bbdd;
    --lane-1: #e6c07b;
    --lane-2: #9aa8ff;
    --lane-3: #7fd38a;
    --lane-4: #f29fb8;
    position: relative;
  }

  :global([data-theme='light']) .panorama {
    --lane-0: #1689ad;
    --lane-1: #b5862c;
    --lane-2: #5560d6;
    --lane-3: #2f9a46;
    --lane-4: #c54a72;
  }

  .panorama-frame {
    position: relative;
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    border-radius: 18px;
    border: 1px solid var(--line);
    background:
      radial-gradient(900px 400px at 85% -10%, var(--accent-soft), transparent 60%), var(--surface);
    overflow: hidden;
  }

  .lane-labels {
    position: relative;
    border-right: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 80%, var(--bg));
  }

  .lane-labels li {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .lane-labels li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--lane);
    box-shadow: 0 0 10px var(--lane);
  }

  .panorama-scroll {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    outline: none;
  }

  .panorama-scroll.is-dragging {
    cursor: grabbing;
  }

  .panorama-scroll:focus-visible {
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  /* 全局样式会把 svg 限制在容器宽度内；全景图按原尺寸绘制，在容器内横向滚动 */
  svg {
    display: block;
    max-width: none;
    height: auto;
    user-select: none;
  }

  /* 时期色带 */
  .era rect {
    fill: transparent;
  }

  .era-alt rect {
    fill: color-mix(in srgb, var(--ink) 3%, transparent);
  }

  .era text {
    font: 600 11.5px var(--font-sans);
    fill: var(--faint);
    letter-spacing: 0.02em;
  }

  .lanes line {
    stroke: var(--line);
  }

  .tick line {
    stroke: var(--line);
    stroke-dasharray: 2 6;
  }

  .tick-major line {
    stroke: var(--line-strong);
    stroke-dasharray: none;
  }

  .tick text {
    font: 11px var(--font-mono);
    fill: var(--faint);
    text-anchor: middle;
  }

  .tick-major text {
    fill: var(--muted);
  }

  .cursor {
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0;
    filter: drop-shadow(0 0 6px var(--glow));
  }

  .is-sweeping .cursor {
    opacity: 1;
  }

  .cursor-trail {
    opacity: 0;
    transition: opacity 0.6s;
  }

  .is-sweeping .cursor-trail {
    opacity: 1;
  }

  /* 连线 */
  .link path {
    fill: none;
  }

  .link-base {
    stroke: color-mix(in srgb, var(--ink) 26%, transparent);
    stroke-width: 1.3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 0.9s var(--ease),
      stroke 0.25s,
      opacity 0.25s;
  }

  /* 同一问题线：固定长度的虚线，淡入而不是描绘 */
  .link-thread .link-base {
    stroke-dasharray: 2 5;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  .link-thread.is-on .link-base {
    opacity: 1;
  }

  .link.is-on .link-base {
    stroke-dashoffset: 0;
  }

  .link-flow {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-dasharray: 3 14;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .is-flowing .link.is-on .link-flow {
    opacity: 0.55;
    animation: flow 2.4s linear infinite;
  }

  .link-thread .link-flow {
    display: none;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -34;
    }
  }

  /* 节点 */
  .node {
    cursor: pointer;
    outline: none;
  }

  .node circle,
  .node text {
    opacity: 0;
    transition:
      opacity 0.45s,
      transform 0.55s var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }

  .node circle {
    transform: scale(0.2);
  }

  .node text {
    transform: translateX(-6px);
  }

  .node.is-on circle,
  .node.is-on text {
    opacity: 1;
    transform: none;
  }

  .node-halo {
    fill: var(--lane);
    opacity: 0;
  }

  .node.is-on .node-halo {
    opacity: 0.14;
  }

  .node-dot {
    fill: var(--surface);
    stroke: var(--lane);
    stroke-width: 2;
  }

  .node-major .node-dot {
    fill: var(--lane);
  }

  .node.is-on.is-pop .node-halo {
    animation: pop 0.9s var(--ease);
  }

  @keyframes pop {
    0% {
      opacity: 0.6;
      transform: scale(0.6);
    }
    100% {
      opacity: 0.14;
      transform: scale(1);
    }
  }

  .node text {
    font: 12.5px var(--font-sans);
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .node-major text {
    font-size: 14px;
    font-weight: 700;
    fill: var(--ink);
  }

  /* 悬停：高亮整条传承链 */
  .has-focus .node:not(.is-related) {
    opacity: 0.22;
  }

  .has-focus .link:not(.is-related) .link-base {
    opacity: 0.12;
  }

  .has-focus .link.is-related .link-base {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node.is-focus .node-halo {
    opacity: 0.32;
  }

  .node:focus-visible .node-dot {
    stroke-width: 3;
  }

  .node {
    transition: opacity 0.25s;
  }

  /* 提示卡片 */
  .tip {
    position: absolute;
    z-index: 3;
    width: min(300px, calc(100% - 16px));
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    pointer-events: auto;
    animation: tip-in 0.22s var(--ease);
  }

  @keyframes tip-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .tip :global(.tip-year) {
    font: 600 12px var(--font-mono);
    color: var(--accent-ink);
  }

  .tip :global(.tip-title) {
    margin-top: 2px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
  }

  .tip :global(.tip-text) {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted);
  }

  .tip :global(.tip-cite) {
    display: inline-flex;
    gap: 4px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--accent-ink);
  }

  .tip :global(.tip-cite:hover) {
    text-decoration: underline;
  }

  /* 图例 */
  .panorama-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .panorama-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .key {
    display: inline-block;
    width: 26px;
    height: 0;
    border-top: 1.5px solid color-mix(in srgb, var(--ink) 40%, transparent);
  }

  .key-thread {
    border-top-style: dashed;
  }

  .key-major {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  .legend-hint {
    margin-left: auto;
    color: var(--faint);
  }

  .replay {
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .replay:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  @media (max-width: 720px) {
    .panorama-frame {
      grid-template-columns: 92px minmax(0, 1fr);
    }

    .lane-labels li {
      padding: 0 8px;
      font-size: 11px;
    }

    .lane-labels li::before {
      display: none;
    }

    .legend-hint {
      margin-left: 0;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node circle,
    .node text,
    .link-base {
      transition: none;
    }
  }
</style>
