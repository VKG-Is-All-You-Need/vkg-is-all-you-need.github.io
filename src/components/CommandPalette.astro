---
import Icon from './ui/Icon.astro';
import { categoriesOf, categoryOf } from '../data/categories';
import { langOf, localize } from '../i18n';
import { getResources, resourceText } from '../lib/resources';
import type { PaletteItem } from '../scripts/palette';

const lang = langOf(Astro.url.pathname);
const resources = await getResources();

const t = {
  zh: {
    pages: [
      { title: '首页', href: '/' },
      { title: '工作原理', href: '/#how', keywords: 'SPARQL SQL 映射 本体 示例' },
      { title: '资源索引', href: '/resources/', keywords: '标准 工具 教程 基准 论文' },
      { title: '学习路径', href: '/learn/', keywords: '入门 教程 术语 辨析' },
      {
        title: 'VKG × 地理信息示例',
        href: '/examples/geo/',
        keywords: 'GeoSPARQL PostGIS 空间 地图 三维 地信 GIS',
      },
      {
        title: 'VKG × 城市数据融合示例',
        href: '/examples/city/',
        keywords:
          '数据融合 动态数据 传感器 温度 湿度 热岛 车辆 轨迹 天气 气象 降雨 大雾 红绿灯 联邦 Trino SOSA',
      },
      { title: '关于本站', href: '/about/', keywords: '贡献 来源 issue 致谢' },
    ],
    label: '站内搜索',
    placeholder: '搜索资源、分类与页面',
    results: '搜索结果',
    empty: '无匹配结果',
    select: '选择',
    open: '打开',
    close: '关闭',
  },
  en: {
    pages: [
      { title: 'Home', href: '/' },
      { title: 'How it works', href: '/#how', keywords: 'SPARQL SQL mapping ontology example' },
      {
        title: 'Resources',
        href: '/resources/',
        keywords: 'standards tools tutorials benchmarks papers',
      },
      { title: 'Learning path', href: '/learn/', keywords: 'getting started tutorial glossary' },
      {
        title: 'VKG × Geospatial example',
        href: '/examples/geo/',
        keywords: 'GeoSPARQL PostGIS spatial map 3D GIS',
      },
      {
        title: 'VKG × Urban data fusion example',
        href: '/examples/city/',
        keywords:
          'data fusion dynamic data sensors temperature humidity heat island vehicles trajectories weather rain fog traffic lights federation Trino SOSA',
      },
      { title: 'About', href: '/about/', keywords: 'contribute sources issue credits' },
    ],
    label: 'Site search',
    placeholder: 'Search resources, categories and pages',
    results: 'Search results',
    empty: 'No matches',
    select: 'Select',
    open: 'Open',
    close: 'Close',
  },
}[lang];

const items: PaletteItem[] = [
  ...t.pages.map((page): PaletteItem => ({
    type: 'page',
    ...page,
    href: localize(page.href, lang),
  })),
  ...categoriesOf(lang).map((category): PaletteItem => ({
    type: 'category',
    title: category.label,
    subtitle: category.description,
    href: localize(`/resources/?category=${category.id}`, lang),
  })),
  ...resources.map((resource): PaletteItem => {
    const { id, data } = resource;
    const text = resourceText(resource, lang);
    return {
      type: 'resource',
      title: text.title,
      subtitle: [categoryOf(data.category, lang).label, data.venue].filter(Boolean).join(' · '),
      href: localize(`/resources/#${id}`, lang),
      keywords: [text.summary, text.note].filter(Boolean).join(' '),
    };
  }),
];

// 防止数据中的 “<” 提前闭合 <script>。
const payload = JSON.stringify(items).replaceAll('<', '\\u003c');
---

<dialog class="palette" data-palette aria-label={t.label}>
  <div class="palette-panel">
    <div class="palette-search">
      <Icon name="search" />
      <input
        data-palette-input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder={t.placeholder}
      />
      <kbd>Esc</kbd>
    </div>
    <div class="palette-body">
      <ul id="palette-list" role="listbox" aria-label={t.results} data-palette-list></ul>
      <p class="palette-empty" data-palette-empty hidden>
        {t.empty}
      </p>
    </div>
    <footer class="palette-foot" aria-hidden="true">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> {t.select}
      </span>
      <span>
        <kbd>Enter</kbd> {t.open}
      </span>
      <span>
        <kbd>Esc</kbd> {t.close}
      </span>
    </footer>
  </div>
</dialog>
<script type="application/json" data-palette-data set:html={payload} />
<style>
  .palette {
    width: min(640px, 100% - 32px);
    max-width: none;
    max-height: none;
    margin: min(14vh, 120px) auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }

  .palette::backdrop {
    background: rgb(4 6 8 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .palette[open] .palette-panel {
    animation: palette-in 0.28s var(--ease);
  }

  .palette[open]::backdrop {
    animation: fade-in 0.28s ease;
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .palette-panel {
    display: flex;
    flex-direction: column;
    max-height: min(560px, 70vh);
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow:
      var(--shadow),
      0 0 0 1px rgb(0 0 0 / 0.2);
    overflow: hidden;
  }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .palette-search input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 16px;
    color: var(--ink);
  }

  .palette-search input::placeholder {
    color: var(--faint);
  }

  .palette-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .palette-body {
    overflow-y: auto;
    padding: 8px;
    overscroll-behavior: contain;
  }

  .palette-body :global(.palette-group) {
    padding: 10px 10px 6px;
    font-size: 12px;
    color: var(--faint);
  }

  .palette-body :global(.palette-option) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    scroll-margin: 8px;
  }

  .palette-body :global(.palette-option[aria-selected='true']) {
    background: var(--accent-soft);
  }

  .palette-body :global(.palette-icon) {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--muted);
  }

  .palette-body :global([aria-selected='true'] .palette-icon) {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .palette-body :global(.palette-text) {
    display: grid;
    min-width: 0;
    line-height: 1.45;
  }

  .palette-body :global(.palette-title) {
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-body :global(.palette-subtitle) {
    font-size: 12px;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-body :global(.palette-enter) {
    margin-left: auto;
    color: var(--faint);
    opacity: 0;
  }

  .palette-body :global([aria-selected='true'] .palette-enter) {
    opacity: 1;
  }

  .palette-empty {
    padding: 40px 0;
    text-align: center;
    color: var(--faint);
  }

  .palette-foot {
    display: flex;
    gap: 20px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--faint);
  }

  .palette-foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 640px) {
    .palette {
      margin-top: 12px;
    }

    .palette-foot {
      display: none;
    }
  }
</style>
