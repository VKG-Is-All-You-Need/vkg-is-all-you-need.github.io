---
import Icon from './ui/Icon.astro';
import { categories, categoryById } from '../data/categories';
import { getResources } from '../lib/resources';
import type { PaletteItem } from '../scripts/palette';

const resources = await getResources();

const items: PaletteItem[] = [
  { type: 'page', title: '首页', href: '/' },
  { type: 'page', title: '工作原理', href: '/#how', keywords: 'SPARQL SQL 映射 本体 示例' },
  { type: 'page', title: '资源索引', href: '/resources/', keywords: '标准 工具 教程 基准 论文' },
  { type: 'page', title: '学习路径', href: '/learn/', keywords: '入门 教程 术语 辨析' },
  {
    type: 'page',
    title: 'VKG × 地理信息示例',
    href: '/examples/geo/',
    keywords: 'GeoSPARQL PostGIS 空间 地图 三维 地信 GIS',
  },
  { type: 'page', title: '关于本站', href: '/about/', keywords: '贡献 来源 issue 致谢' },
  ...categories.map((category): PaletteItem => ({
    type: 'category',
    title: category.label,
    subtitle: category.description,
    href: `/resources/?category=${category.id}`,
  })),
  ...resources.map(({ id, data }): PaletteItem => ({
    type: 'resource',
    title: data.title,
    subtitle: [categoryById.get(data.category)?.label, data.venue].filter(Boolean).join(' · '),
    href: `/resources/#${id}`,
    keywords: [data.summary, data.note].filter(Boolean).join(' '),
  })),
];

// 防止数据中的 “<” 提前闭合 <script>。
const payload = JSON.stringify(items).replaceAll('<', '\\u003c');
---

<dialog class="palette" data-palette aria-label="站内搜索">
  <div class="palette-panel">
    <div class="palette-search">
      <Icon name="search" />
      <input
        data-palette-input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder="搜索资源、分类与页面"
      />
      <kbd>Esc</kbd>
    </div>
    <div class="palette-body">
      <ul id="palette-list" role="listbox" aria-label="搜索结果" data-palette-list></ul>
      <p class="palette-empty" data-palette-empty hidden>
        无匹配结果
      </p>
    </div>
    <footer class="palette-foot" aria-hidden="true">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> 选择
      </span>
      <span>
        <kbd>Enter</kbd> 打开
      </span>
      <span>
        <kbd>Esc</kbd> 关闭
      </span>
    </footer>
  </div>
</dialog>
<script type="application/json" data-palette-data set:html={payload} />
<style>
  .palette {
    width: min(640px, 100% - 32px);
    max-width: none;
    max-height: none;
    margin: min(14vh, 120px) auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }

  .palette::backdrop {
    background: rgb(4 6 8 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .palette[open] .palette-panel {
    animation: palette-in 0.28s var(--ease);
  }

  .palette[open]::backdrop {
    animation: fade-in 0.28s ease;
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .palette-panel {
    display: flex;
    flex-direction: column;
    max-height: min(560px, 70vh);
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow:
      var(--shadow),
      0 0 0 1px rgb(0 0 0 / 0.2);
    overflow: hidden;
  }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .palette-search input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 16px;
    color: var(--ink);
  }

  .palette-search input::placeholder {
    color: var(--faint);
  }

  .palette-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .palette-body {
    overflow-y: auto;
    padding: 8px;
    overscroll-behavior: contain;
  }

  .palette-body :global(.palette-group) {
    padding: 10px 10px 6px;
    font-size: 12px;
    color: var(--faint);
  }

  .palette-body :global(.palette-option) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    scroll-margin: 8px;
  }

  .palette-body :global(.palette-option[aria-selected='true']) {
    background: var(--accent-soft);
  }

  .palette-body :global(.palette-icon) {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--muted);
  }

  .palette-body :global([aria-selected='true'] .palette-icon) {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .palette-body :global(.palette-text) {
    display: grid;
    min-width: 0;
    line-height: 1.45;
  }

  .palette-body :global(.palette-title) {
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-body :global(.palette-subtitle) {
    font-size: 12px;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-body :global(.palette-enter) {
    margin-left: auto;
    color: var(--faint);
    opacity: 0;
  }

  .palette-body :global([aria-selected='true'] .palette-enter) {
    opacity: 1;
  }

  .palette-empty {
    padding: 40px 0;
    text-align: center;
    color: var(--faint);
  }

  .palette-foot {
    display: flex;
    gap: 20px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--faint);
  }

  .palette-foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 640px) {
    .palette {
      margin-top: 12px;
    }

    .palette-foot {
      display: none;
    }
  }
</style>
