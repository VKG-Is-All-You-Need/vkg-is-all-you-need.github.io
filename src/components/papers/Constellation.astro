---
/**
 * 文献星图（文献页的动效版本）：每篇论文一颗星，星点大小随库内被引次数增大。
 * 连线有两类：发展历程页的传承关系，以及论文之间的引用（src/data/citations.json）。
 * 布局由 lib/constellation 中的注册表提供，各布局的坐标与背景都在构建时计算；
 * 扫描、布局切换、悬停与筛选联动见 scripts/papers-fx.ts。
 */
import { MILESTONES } from '../../data/history';
import { PAPER_TOPICS } from '../../data/papers';
import { langOf, localize } from '../../i18n';
import { buildContext, buildLayouts, linkPath } from '../../lib/constellation';
import { getPapers, getRepos, paperSummary } from '../../lib/papers';

const lang = langOf(Astro.url.pathname);
const papers = await getPapers();
const repos = await getRepos();
const ctx = buildContext(papers, repos, lang);

const reposByPaper = new Map<string, string[]>();
for (const repo of repos) {
  if (repo.data.paper) {
    reposByPaper.set(repo.data.paper, [
      ...(reposByPaper.get(repo.data.paper) ?? []),
      repo.data.repo,
    ]);
  }
}

const links = ctx.links;
const lineageCount = links.filter((link) => link.kind !== 'citation').length;
const citationCount = links.length - lineageCount;

const layouts = buildLayouts(ctx);
const initial = layouts[0];

// 星点大小：被库内引用越多越大，最多约为基础大小的 1.9 倍
const maxCited = Math.max(1, ...ctx.stars.map((star) => star.cited));
const sizeOf = (cited: number) => 1 + 0.9 * Math.sqrt(cited / maxCited);
const maxHeight = Math.max(...layouts.map((layout) => layout.height));
const maxWidth = Math.max(...layouts.map((layout) => layout.width));

// 背景星点：固定种子的伪随机数，保证每次构建结果一致
let seed = 20020611;
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const dust = Array.from({ length: Math.round((maxWidth * maxHeight) / 4200) }, () => ({
  x: random() * maxWidth,
  y: random() * maxHeight,
  r: 0.4 + random() * 0.9,
  o: 0.15 + random() * 0.45,
  d: (random() * 6).toFixed(2),
}));

const withCode = ctx.stars.filter((star) => star.code).length;
const layoutNames = layouts.map((layout) => layout.label).join(lang === 'zh' ? '、' : ', ');

const t = {
  zh: {
    label: `文献星图：每颗星代表一篇论文，星越大表示被库内其他论文引用得越多，带光环的论文附有代码；连线表示发展历程页中的传承关系与论文之间的引用。可选布局：${layoutNames}。`,
    title: '文献星图',
    sub: `VKG / OBDA · ${ctx.from}–${ctx.to}`,
    papers: '论文',
    code: '附代码',
    repos: '仓库',
    citations: '引用',
    keyPaper: '论文（越大被引越多）',
    keyCode: '附有代码',
    relations: '显示的关系',
    lineage: '传承',
    citation: '引用',
    coauthor: '同作者',
    relationTitle: {
      lineage: '发展历程页中的传承关系',
      citation: '论文之间的引用，数据来自 OpenAlex、Semantic Scholar 与 Crossref',
      coauthor: '悬停时同时高亮有共同作者的论文',
    },
    hint: '悬停或点击星点查看论文 · 搜索会同步点亮星图',
    replay: '重放',
    layout: '布局',
  },
  en: {
    label: `Paper constellation: each star is a paper, larger stars are cited more often within the library, and a ring marks papers with code; lines show lineage from the history page and citations between papers. Layouts: ${layoutNames}.`,
    title: 'Paper constellation',
    sub: `VKG / OBDA · ${ctx.from}–${ctx.to}`,
    papers: 'papers',
    code: 'with code',
    repos: 'repos',
    citations: 'citations',
    keyPaper: 'Paper (larger: cited more)',
    keyCode: 'With code',
    relations: 'Relations shown',
    lineage: 'Lineage',
    citation: 'Citations',
    coauthor: 'Co-authors',
    relationTitle: {
      lineage: 'Lineage from the history page',
      citation: 'Citations between papers, from OpenAlex, Semantic Scholar and Crossref',
      coauthor: 'On hover, also highlight papers that share an author',
    },
    hint: 'Hover or tap a star for the paper · Search lights up matching stars',
    replay: 'Replay',
    layout: 'Layout',
  },
}[lang];

const stats = [
  { value: papers.length, label: t.papers },
  { value: withCode, label: t.code },
  { value: citationCount, label: t.citations },
  { value: repos.length, label: t.repos },
];

/** 客户端切换布局所需的数据；背景图形已渲染在各自的图层中，不再重复。 */
const clientLayouts = layouts.map(
  ({ shapes: _shapes, label: _label, icon: _icon, positions, ...rest }) => ({
    ...rest,
    positions: Object.fromEntries(Object.entries(positions).map(([id, p]) => [id, [p.x, p.y]])),
  }),
);
---

<figure
  class:list={['constellation', { 'is-fit': initial.fit, 'is-stacked': !initial.rows }]}
  data-constellation
  data-layout={initial.id}
>
  <div class="sky">
    <div class="nebula" aria-hidden="true"></div>
    <div class="meteors" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>

    <header class="hud">
      <div class="hud-title">
        <span class="hud-pulse" aria-hidden="true"></span>
        <strong>{t.title}</strong>
        <span class="hud-sub">{t.sub}</span>
        <div class="layout-switch" role="group" aria-label={t.layout}>
          {layouts.map((layout, i) => (
            <button
              type="button"
              data-sky-layout={layout.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              title={layout.label}
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" set:html={layout.icon} />
              <span>{layout.label}</span>
            </button>
          ))}
        </div>
      </div>
      <dl class="hud-stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd data-count={stat.value}>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="frame">
      <ol class="lane-labels" aria-hidden="true" style={`--n:${ctx.topics.length}`}>
        {ctx.topics.map((topic, i) => (
          <li
            data-row
            style={`--i:${i};--c:${topic.color}${initial.rows ? `;top:${initial.rows[i].top}px;height:${initial.rows[i].height}px` : ''}`}
          >
            <span title={topic.label}>{topic.short}</span>
          </li>
        ))}
        {layouts.flatMap((layout) =>
          (layout.notes ?? []).map((note) => (
            <li
              class="note"
              data-note={layout.id}
              hidden={layout !== initial}
              style={`top:${note.top}px;height:${note.height}px`}
            >
              <span>{note.text}</span>
            </li>
          )),
        )}
      </ol>
      <div class="scroll" data-sky-scroll tabindex="0" aria-label={t.label}>
        <svg
          width={initial.width}
          height={initial.height}
          viewBox={`0 0 ${initial.width} ${initial.height}`}
          role="img"
          aria-label={t.label}
          data-sky-svg
        >
          <defs>
            <radialGradient id="star-glow">
              <stop offset="0" stop-color="#fff" stop-opacity="0.9"></stop>
              <stop offset="0.35" stop-color="currentColor" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
            </radialGradient>
            <radialGradient id="core-glow">
              <stop offset="0" stop-color="#bfeaff" stop-opacity="0.85"></stop>
              <stop offset="0.4" stop-color="#49bbdd" stop-opacity="0.3"></stop>
              <stop offset="1" stop-color="#49bbdd" stop-opacity="0"></stop>
            </radialGradient>
            <linearGradient id="sweep-glow" x1="0" x2="1">
              <stop offset="0" stop-color="#7fd3ec" stop-opacity="0"></stop>
              <stop offset="1" stop-color="#7fd3ec" stop-opacity="0.18"></stop>
            </linearGradient>
          </defs>

          <g class="dust" data-sky-dust>
            {dust.map((p) => (
              <circle
                cx={p.x.toFixed(1)}
                cy={p.y.toFixed(1)}
                r={p.r.toFixed(2)}
                style={`--o:${p.o.toFixed(2)};--d:${p.d}s`}
              />
            ))}
          </g>

          {layouts.map((layout) => (
            <g class:list={['layer', { 'is-active': layout === initial }]} data-layer={layout.id}>
              {layout.shapes.map(({ tag: Tag, class: className, text, ...attrs }) => (
                <Tag class={className} {...attrs}>
                  {text}
                </Tag>
              ))}
              {layout.sweep.kind === 'line' && (
                <>
                  <rect
                    class="sweep-trail"
                    x="0"
                    y="0"
                    width="0"
                    height={layout.height}
                    fill="url(#sweep-glow)"
                    data-sweep-trail
                  />
                  <line class="sweep" x1="0" x2="0" y1="0" y2={layout.height} data-sweep-line />
                </>
              )}
              {layout.sweep.kind === 'ripple' && (
                <circle
                  class="ripple"
                  cx={layout.sweep.cx}
                  cy={layout.sweep.cy}
                  r="0"
                  data-ripple={layout.sweep.r}
                />
              )}
              {layout.sweep.kind === 'trace' && (
                <path class="trace" d={layout.sweep.d} pathLength="1" data-trace />
              )}
            </g>
          ))}

          <g class="links">
            {links.map((link) => {
              const d = linkPath(
                initial.link,
                initial.positions[link.from],
                initial.positions[link.to],
              );
              return (
                <g
                  class:list={['link', `link-${link.kind}`]}
                  data-from={link.from}
                  data-to={link.to}
                  data-kind={link.kind}
                >
                  <path
                    class="link-base"
                    d={d}
                    pathLength={link.kind === 'thread' ? undefined : 1}
                  />
                  {link.kind === 'cite' && <path class="link-flow" d={d} />}
                </g>
              );
            })}
          </g>

          <g class="stars">
            {ctx.stars.map((star, i) => {
              const p = initial.positions[star.id];
              return (
                <g
                  class:list={['star', { 'has-code': star.code }]}
                  style={`--c:${ctx.topics[star.topic].color};--cx:${p.x};--cy:${p.y};--tw:${(2.6 + ((i * 7) % 23) / 10).toFixed(1)}s;--twd:${(((i * 13) % 37) / 10).toFixed(1)}s`}
                  data-star={star.id}
                  tabindex="0"
                  role="button"
                  aria-label={`${star.year} ${papers.find((paper) => paper.id === star.id)!.data.title}`}
                >
                  <g class="star-pos">
                    <circle class="star-hit" r={Math.max(10, 6 + 4 * sizeOf(star.cited))} />
                    <circle
                      class="star-glow"
                      r={(13 * sizeOf(star.cited)).toFixed(1)}
                      fill="url(#star-glow)"
                    />
                    {star.code && (
                      <circle class="star-ring" r={(4.3 + 3.2 * sizeOf(star.cited)).toFixed(1)} />
                    )}
                    <circle class="star-burst" r={(9 * sizeOf(star.cited)).toFixed(1)} />
                    <circle class="star-core" r={(3.2 * sizeOf(star.cited)).toFixed(1)} />
                    <circle class="star-peer" r={(6 + 3 * sizeOf(star.cited)).toFixed(1)} />
                  </g>
                </g>
              );
            })}
          </g>
        </svg>
        <div class="tip" data-sky-tip hidden></div>
      </div>
    </div>

    <figcaption class="legend">
      <span>
        <i class="key key-paper"></i>
        {t.keyPaper}
      </span>
      <span>
        <i class="key key-code"></i>
        {t.keyCode}
      </span>
      <div class="relations" role="group" aria-label={t.relations}>
        {(['lineage', 'citation', 'coauthor'] as const).map((relation) => (
          <button
            type="button"
            data-relation={relation}
            aria-pressed="true"
            title={t.relationTitle[relation]}
          >
            <i class:list={['key', `key-${relation}`]}></i>
            {relation === 'lineage'
              ? `${t.lineage} ${lineageCount}`
              : relation === 'citation'
                ? `${t.citation} ${citationCount}`
                : t.coauthor}
          </button>
        ))}
      </div>
      <span class="legend-hint">{t.hint}</span>
      <button type="button" class="replay" data-sky-replay>
        {t.replay}
      </button>
    </figcaption>
  </div>

  <script
    type="application/json"
    data-sky-layouts
    set:html={JSON.stringify(clientLayouts).replaceAll('<', '\\u003c')}
  />
  <script
    type="application/json"
    data-sky-data
    set:html={JSON.stringify(
      Object.fromEntries(
        papers.map((paper) => [
          paper.id,
          {
            year: paper.data.year,
            title: paper.data.title,
            authors: paper.data.authors,
            venue: paper.data.venue,
            summary: paperSummary(paper, lang),
            url: paper.data.url,
            code: paper.data.code ?? null,
            repos: reposByPaper.get(paper.id) ?? [],
            topic: ctx.topics[PAPER_TOPICS.indexOf(paper.data.topic)].label,
            history: MILESTONES.some((m) => m.paper === paper.id)
              ? localize('/history/', lang)
              : null,
          },
        ]),
      ),
    ).replaceAll('<', '\\u003c')}
  />
</figure>

<style>
  /* 星图始终使用深色画布，两种主题下观感一致 */
  .constellation {
    --sky-bg: #04060c;
    --sky-ink: #e9eef5;
    --sky-ink-2: #b9c2cd;
    --sky-muted: #7f8a97;
    --sky-faint: #4d5662;
    --sky-line: rgb(160 190 230 / 0.09);
    --sky-line-strong: rgb(160 190 230 / 0.18);
    margin: 0 0 8px;
  }

  .sky {
    position: relative;
    isolation: isolate;
    border-radius: 20px;
    border: 1px solid rgb(120 170 230 / 0.16);
    background: var(--sky-bg);
    color: var(--sky-ink);
    overflow: hidden;
    box-shadow:
      0 40px 90px -40px rgb(20 80 140 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  /* 缓慢漂移的星云 */
  .nebula {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(38% 42% at 22% 30%, rgb(73 140 221 / 0.22), transparent 70%),
      radial-gradient(30% 36% at 78% 62%, rgb(170 110 240 / 0.16), transparent 70%),
      radial-gradient(26% 30% at 60% 18%, rgb(73 221 200 / 0.1), transparent 70%);
    filter: blur(20px);
    animation: drift 28s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate3d(4%, -3%, 0) rotate(6deg) scale(1.06);
    }
  }

  /* 流星 */
  .meteors i {
    position: absolute;
    z-index: -1;
    top: 0;
    width: 140px;
    height: 1px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.9), transparent);
    transform: rotate(-24deg) translateX(0);
    opacity: 0;
    animation: meteor 9s linear infinite;
  }

  .meteors i:nth-child(1) {
    top: 18%;
    left: 70%;
  }

  .meteors i:nth-child(2) {
    top: 8%;
    left: 40%;
    animation-delay: 3.4s;
    animation-duration: 11s;
  }

  .meteors i:nth-child(3) {
    top: 30%;
    left: 92%;
    animation-delay: 6.8s;
    animation-duration: 13s;
  }

  @keyframes meteor {
    0% {
      opacity: 0;
      transform: rotate(-24deg) translateX(0);
    }
    2% {
      opacity: 1;
    }
    9% {
      opacity: 0;
      transform: rotate(-24deg) translateX(-520px);
    }
    100% {
      opacity: 0;
      transform: rotate(-24deg) translateX(-520px);
    }
  }

  /* 顶栏 */
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 16px 20px 6px;
  }

  .hud-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    font-size: 15px;
  }

  .hud-title strong {
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .hud-sub {
    font: 12px var(--font-mono);
    color: var(--sky-muted);
  }

  .layout-switch {
    display: inline-flex;
    align-self: center;
    margin-left: 6px;
    padding: 2px;
    border-radius: 999px;
    border: 1px solid var(--sky-line-strong);
    background: rgb(255 255 255 / 0.03);
  }

  .layout-switch button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12px;
    white-space: nowrap;
    color: var(--sky-muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .layout-switch button:hover {
    color: var(--sky-ink);
  }

  .layout-switch button[aria-pressed='true'] {
    background: rgb(127 211 236 / 0.16);
    color: #bfeaff;
  }

  .layout-switch svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .hud-pulse {
    align-self: center;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7fd3ec;
    box-shadow: 0 0 0 0 rgb(127 211 236 / 0.6);
    animation: pulse 2.2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      box-shadow: 0 0 0 10px rgb(127 211 236 / 0);
    }
  }

  .hud-stats {
    display: flex;
    gap: 22px;
  }

  .hud-stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
  }

  .hud-stats dd {
    font: 600 22px/1.1 var(--font-mono);
    color: var(--sky-ink);
    text-shadow: 0 0 18px rgb(127 211 236 / 0.45);
    font-variant-numeric: tabular-nums;
  }

  .hud-stats dt {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--sky-muted);
  }

  /* 画布 */
  .frame {
    position: relative;
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
  }

  .lane-labels {
    position: relative;
    border-right: 1px solid var(--sky-line);
  }

  .lane-labels li {
    position: absolute;
    left: 0;
    right: 0;
    transition:
      top 0.8s var(--ease),
      height 0.8s var(--ease);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 0 18px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--sky-ink-2);
  }

  .lane-labels li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .lane-labels li[hidden] {
    display: none;
  }

  .lane-labels .note {
    font-size: 11px;
    color: var(--sky-faint);
  }

  .lane-labels .note::before {
    display: none;
  }

  /* 没有泳道的布局：主题标签收拢为左侧图例，画布较矮时由图例撑开高度 */
  .is-stacked .lane-labels {
    min-height: calc(40px + var(--n) * 30px);
  }

  .is-stacked .lane-labels li[data-row] {
    top: calc(20px + var(--i) * 30px);
    height: 30px;
  }

  .scroll {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--sky-line-strong) transparent;
    outline: none;
  }

  .scroll:focus-visible {
    box-shadow: inset 0 0 0 2px #7fd3ec;
  }

  svg {
    display: block;
    max-width: none;
    height: auto;
    user-select: none;
  }

  /* 缩放布局：画布缩放到容器宽度并居中 */
  .is-fit svg {
    max-width: 100%;
    margin-inline: auto;
  }

  /* 每个布局的背景在各自的图层中，只显示当前布局的图层 */
  .layer {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s;
  }

  .layer.is-active {
    opacity: 1;
  }

  /* ── 背景图形（由 lib/constellation 的布局生成，按 class 匹配） ── */
  .layer :global(text) {
    font-family: var(--font-sans);
  }

  /* 通用：时期色带、网格、年份刻度、随扫描出现的计数 */
  .layer :global(rect.era) {
    fill: transparent;
  }

  .layer :global(rect.era-alt) {
    fill: rgb(150 190 255 / 0.025);
  }

  .layer :global(.era-label) {
    font-size: 11px;
    font-weight: 600;
    fill: var(--sky-faint);
    letter-spacing: 0.02em;
  }

  .layer :global(.grid),
  .layer :global(.baseline) {
    stroke: var(--sky-line);
  }

  .layer :global(.baseline) {
    stroke: var(--sky-line-strong);
  }

  .layer :global(line.tick) {
    stroke: var(--sky-line);
    stroke-dasharray: 2 6;
  }

  .layer :global(line.tick-major) {
    stroke: var(--sky-line-strong);
    stroke-dasharray: none;
  }

  .layer :global(.tick-label) {
    font: 10.5px var(--font-mono);
    fill: var(--sky-faint);
    text-anchor: middle;
  }

  .layer :global(text.tick-major) {
    fill: var(--sky-muted);
  }

  .layer :global([data-p]) {
    opacity: 0;
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease);
  }

  .layer :global([data-p].is-on) {
    opacity: 1;
  }

  .layer :global(rect.bar) {
    fill: rgb(127 211 236 / 0.28);
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0);
  }

  .layer :global(rect.bar.is-on) {
    transform: none;
  }

  .layer :global(.bar-count) {
    font: 9.5px var(--font-mono);
    fill: var(--sky-muted);
    text-anchor: middle;
  }

  .layer :global(.rim-label) {
    font-size: 12px;
    font-weight: 600;
    fill: var(--c);
    opacity: 0.85;
  }

  /* 放射 */
  .layer :global(.ring-era) {
    fill: none;
    stroke: transparent;
  }

  .layer :global(.ring-era-alt) {
    stroke: rgb(150 190 255 / 0.03);
  }

  .layer :global(circle.ring-year) {
    fill: none;
    stroke: var(--sky-line-strong);
    stroke-dasharray: 2 5;
  }

  .layer :global(.ring-year-label),
  .layer :global(.spiral-year) {
    font: 10.5px var(--font-mono);
    fill: var(--sky-muted);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--sky-bg);
    stroke-width: 3px;
  }

  .layer :global(.spoke) {
    fill: none;
    stroke: var(--sky-line);
  }

  .layer :global(.core) {
    animation: core 4s ease-in-out infinite alternate;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes core {
    to {
      transform: scale(1.25);
      opacity: 0.7;
    }
  }

  .layer :global(.core-label) {
    font: 600 10.5px var(--font-mono);
    fill: var(--sky-ink);
    text-anchor: middle;
  }

  /* 螺旋 */
  .layer :global(.spiral) {
    fill: none;
    stroke: var(--sky-line-strong);
    stroke-width: 1;
  }

  .layer :global(.spiral-era) {
    fill: none;
    stroke: rgb(127 211 236 / 0.16);
    stroke-width: 22;
    stroke-linecap: round;
    opacity: 0.35;
  }

  .layer :global(.spiral-era-alt) {
    stroke: rgb(170 140 255 / 0.16);
  }

  .layer :global(.spiral-era-label) {
    font-size: 10.5px;
    font-weight: 600;
    fill: var(--sky-muted);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--sky-bg);
    stroke-width: 4px;
  }

  .layer :global(.spiral-mark) {
    fill: var(--sky-muted);
  }

  /* 星团 */
  .layer :global(.cluster-halo) {
    fill: color-mix(in srgb, var(--c) 7%, transparent);
    stroke: color-mix(in srgb, var(--c) 30%, transparent);
  }

  .layer :global(.cluster-orbit) {
    fill: none;
    stroke: color-mix(in srgb, var(--c) 22%, transparent);
    stroke-dasharray: 2 6;
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 60s linear infinite;
  }

  .layer :global(.cluster-label) {
    font-size: 13px;
    font-weight: 700;
    fill: var(--c);
    text-anchor: middle;
  }

  .layer :global(.cluster-meta) {
    font: 10.5px var(--font-mono);
    fill: var(--sky-muted);
    text-anchor: middle;
  }

  /* 环形 */
  .layer :global(.ring-band) {
    fill: none;
    stroke: rgb(150 190 255 / 0.035);
  }

  .layer :global(.ring-edge) {
    fill: none;
    stroke: var(--sky-line);
    stroke-dasharray: 2 5;
  }

  .layer :global(.ring-arc) {
    fill: none;
    stroke: var(--c);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .layer :global(.ring-note) {
    font-size: 11.5px;
    fill: var(--sky-muted);
    text-anchor: middle;
  }

  .layer :global(.ring-note-years) {
    font-family: var(--font-mono);
    fill: var(--sky-faint);
  }

  /* 网络 */
  .layer :global(.network-note) {
    font-size: 11px;
    fill: var(--sky-faint);
    text-anchor: end;
  }

  /* 扫描：沿路径描绘 */
  .trace {
    fill: none;
    stroke: #7fd3ec;
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 5px #7fd3ec);
    transition: opacity 0.6s;
  }

  .is-sweeping .trace {
    opacity: 1;
  }

  .ripple {
    fill: none;
    stroke: #7fd3ec;
    stroke-width: 1.5;
    opacity: 0;
    filter: drop-shadow(0 0 6px #7fd3ec);
  }

  .is-sweeping .ripple {
    opacity: 1;
  }

  /* 布局切换时星点移动到新位置，按新布局的扫描顺序依次出发 */
  .star-pos {
    transform: translate(calc(var(--cx) * 1px), calc(var(--cy) * 1px));
    transition: transform 1s cubic-bezier(0.65, 0, 0.25, 1) var(--delay, 0ms);
  }

  .links {
    transition: opacity 0.4s;
  }

  .is-morphing .links {
    opacity: 0;
    transition-duration: 0.15s;
  }

  .dust {
    transform: translate(var(--px, 0), var(--py, 0));
    transition: transform 0.8s var(--ease);
  }

  .dust circle {
    fill: #cfe3ff;
    opacity: var(--o);
    animation: dust 5s ease-in-out var(--d) infinite alternate;
  }

  @keyframes dust {
    to {
      opacity: 0.05;
    }
  }

  /* 扫描线 */
  .sweep {
    stroke: #7fd3ec;
    stroke-width: 1.5;
    opacity: 0;
    filter: drop-shadow(0 0 6px #7fd3ec);
  }

  .sweep-trail {
    opacity: 0;
    transition: opacity 0.6s;
  }

  .is-sweeping .sweep,
  .is-sweeping .sweep-trail {
    opacity: 1;
  }

  /* 传承连线 */
  .link path {
    fill: none;
  }

  .link-base {
    stroke: rgb(190 215 255 / 0.28);
    stroke-width: 1.1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1s var(--ease),
      stroke 0.25s,
      opacity 0.25s;
  }

  /* 同一问题线：固定长度的虚线，淡入而不是描绘 */
  .link-thread .link-base {
    stroke-dasharray: 2 5;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  .link.is-on .link-base {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .link-thread .link-flow {
    display: none;
  }

  .link-flow {
    stroke: #bfeaff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 2 40;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .is-done .link.is-on .link-flow {
    opacity: 0.8;
    animation: flow 3s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -42;
    }
  }

  /* 星点 */
  .star {
    color: var(--c);
    cursor: pointer;
    outline: none;
    transition: opacity 0.3s;
  }

  .star-hit {
    fill: transparent;
  }

  .star circle:not(.star-hit) {
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
  }

  .star-core {
    fill: var(--c);
    filter: drop-shadow(0 0 3px var(--c));
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s,
      transform 0.5s cubic-bezier(0.34, 1.8, 0.5, 1);
  }

  .star-glow {
    opacity: 0;
    transition: opacity 0.6s;
  }

  .star-ring {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.1;
    stroke-dasharray: 3 2.6;
    opacity: 0;
    transition: opacity 0.6s 0.2s;
  }

  .star-burst {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.5;
    opacity: 0;
  }

  .star.is-on .star-core {
    opacity: 1;
    transform: none;
  }

  .star.is-on .star-glow {
    opacity: 0.7;
  }

  .star.is-on .star-ring {
    opacity: 0.85;
  }

  .star.is-pop .star-burst {
    animation: burst 0.9s var(--ease) forwards;
  }

  @keyframes burst {
    0% {
      opacity: 0.9;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .is-done .star.is-on .star-glow {
    animation: twinkle var(--tw) ease-in-out var(--twd) infinite alternate;
  }

  .is-done .star-ring {
    animation: spin 10s linear infinite;
  }

  @keyframes twinkle {
    to {
      opacity: 0.25;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .star:hover .star-core,
  .star:focus-visible .star-core,
  .star.is-focus .star-core {
    transform: scale(1.6);
  }

  /* 悬停：高亮整条传承链 */
  .has-focus .star:not(.is-related) {
    opacity: 0.18;
  }

  .has-focus .link:not(.is-related) {
    opacity: 0.1;
  }

  .has-focus .link.is-related .link-base {
    stroke: #bfeaff;
    stroke-width: 1.8;
  }

  .has-focus .link-citation.is-related .link-base {
    stroke: rgb(170 215 255 / 0.75);
    stroke-width: 1.1;
  }

  /* 有共同作者的论文：比无关论文亮，并加一圈虚线 */
  .has-focus .star.is-peer:not(.is-related) {
    opacity: 0.75;
  }

  .star-peer {
    fill: none;
    stroke: #f5d77a;
    stroke-width: 1;
    stroke-dasharray: 1.5 2.5;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .has-focus .star.is-peer .star-peer {
    opacity: 0.9;
  }

  /* 关系开关 */
  .hide-lineage .link-cite,
  .hide-lineage .link-thread,
  .hide-citation .link-citation {
    display: none;
  }

  /* 引用：数量多，画得细而淡 */
  .link-citation .link-base {
    stroke: rgb(170 200 255 / 0.13);
    stroke-width: 0.7;
  }

  /* 筛选：不匹配的星点变暗 */
  .is-filtered .star.is-off {
    opacity: 0.1;
  }

  .is-filtered .star:not(.is-off) .star-glow {
    opacity: 1;
  }

  .is-filtered .link {
    opacity: 0.25;
  }

  /* 提示卡片 */
  .tip {
    position: absolute;
    z-index: 3;
    max-height: calc(100% - 12px);
    overflow-y: auto;
    pointer-events: none;
    width: min(320px, calc(100% - 16px));
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgb(140 190 240 / 0.25);
    background: rgb(10 16 28 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 20px 50px -20px rgb(0 0 0 / 0.9),
      0 0 30px -10px rgb(127 211 236 / 0.4);
    animation: tip-in 0.22s var(--ease);
  }

  .tip.is-pinned {
    pointer-events: auto;
  }

  @keyframes tip-in {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
    }
  }

  .tip :global(.tip-meta) {
    display: flex;
    gap: 8px;
    font: 600 11.5px var(--font-mono);
    color: #7fd3ec;
  }

  .tip :global(.tip-meta span:last-child) {
    color: var(--sky-muted);
    font-weight: 500;
  }

  .tip :global(.tip-title) {
    margin-top: 4px;
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--sky-ink);
  }

  .tip :global(.tip-authors) {
    margin-top: 3px;
    font-size: 12px;
    color: var(--sky-muted);
  }

  .tip :global(.tip-text) {
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--sky-ink-2);
  }

  .tip :global(.tip-relations) {
    margin-top: 6px;
    font: 11.5px var(--font-mono);
    color: #f5d77a;
    opacity: 0.85;
  }

  .tip :global(.tip-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-top: 8px;
    font-size: 12px;
  }

  .tip :global(.tip-links a) {
    color: #7fd3ec;
  }

  .tip :global(.tip-links a:hover) {
    text-decoration: underline;
  }

  /* 图例 */
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    padding: 6px 20px 14px;
    font-size: 12px;
    color: var(--sky-muted);
  }

  .legend span {
