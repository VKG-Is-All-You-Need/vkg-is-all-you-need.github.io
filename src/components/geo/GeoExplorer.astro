---
import Icon from '../ui/Icon.astro';
import { city } from '../../lib/geo/city';
import { queries } from '../../lib/geo/queries';

const nameOf = (id: number) => city.buildings.find((b) => b.id === id)!.name;
const first = queries[0].run(city);
---

<div class="geo" data-geo>
  <div class="stage" data-geo-stage>
    <div class="viewport" data-geo-viewport>
      <div class="pins" data-geo-pins aria-hidden="true"></div>
      <p class="status" data-geo-status role="status"></p>
      <ol class="steps" aria-label="查询执行过程">
        <li data-geo-step>
          <span>1</span>本体推理
        </li>
        <li data-geo-step>
          <span>2</span>映射改写
        </li>
        <li data-geo-step>
          <span>3</span>空间 SQL
        </li>
        <li data-geo-step>
          <span>4</span>返回结果
        </li>
      </ol>
      <div class="toolbar" role="group" aria-label="场景控制">
        <button type="button" data-geo-view aria-pressed="true">
          <Icon name="layers" size={16} />
          <span data-label>分层</span>
        </button>
        <button type="button" data-geo-mode aria-pressed="true">
          <Icon name="moon" size={16} class="when-night" />
          <Icon name="sun" size={16} class="when-day" />
          <span data-label>夜晚</span>
        </button>
        <button type="button" data-geo-rotate aria-pressed="false">
          <Icon name="rotate" size={16} />
          <span>自动旋转</span>
        </button>
        <button type="button" data-geo-reset>
          <Icon name="home" size={16} />
          <span>复位视角</span>
        </button>
        <button type="button" data-geo-fullscreen aria-pressed="false" aria-label="全屏">
          <Icon name="maximize" size={16} class="when-normal" />
          <Icon name="minimize" size={16} class="when-full" />
          <span data-label>全屏</span>
        </button>
        <span class="hint">拖动旋转 · 滚轮缩放 · 点击建筑查看数据 · F 全屏</span>
      </div>
      <figure class="planbox">
        <canvas data-geo-plan role="img" aria-label="街区平面图，点击可选择建筑"></canvas>
        <figcaption>
          平面图 <span>N ↑</span>
        </figcaption>
      </figure>
    </div>

    <aside class="panel panel-queries" aria-label="示例查询">
      <p class="panel-label">示例查询</p>
      <div class="queries">
        {queries.map((query, i) => (
          <button type="button" data-query={query.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="q-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="q-body">
              <span class="q-title">{query.title}</span>
              <span class="q-feature">{query.feature}</span>
            </span>
          </button>
        ))}
      </div>
      <div class="results" data-geo-results>
        <p class="results-head">
          结果 <span>{first.hits.length} 项</span>
          <code>{queries[0].feature}</code>
        </p>
        <ul role="list">
          {first.hits.map((hit) => (
            <li>
              <span class="result">
                <span class="result-name">{nameOf(hit.id)}</span>
                <span class="result-detail">{hit.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <aside class="panel panel-info" data-geo-info aria-live="polite">
      <p class="info-kind">分层视图</p>
      <h3 class="info-title">一次查询经过的四层</h3>
      <ol class="layer-legend" role="list">
        <li>
          <i class="swatch swatch-onto"></i>
          <b>本体</b>
          <span>类与类之间的关系，例如 :School ⊑ :PublicFacility。</span>
        </li>
        <li>
          <i class="swatch swatch-graph"></i>
          <b>虚拟知识图谱</b>
          <span>由映射按需生成的实体，节点位于对应建筑的正上方。</span>
        </li>
        <li>
          <i class="swatch swatch-map"></i>
          <b>映射</b>
          <span>将表中的行与几何列转换为三元组。</span>
        </li>
        <li>
          <i class="swatch swatch-data"></i>
          <b>数据源</b>
          <span>PostGIS 中的表与几何，数据不迁移。</span>
        </li>
      </ol>
      <p class="info-text">
        点击任意建筑，查看它在各层中的对应：数据库记录、虚拟三元组与所属的类。
      </p>
    </aside>
  </div>
</div>

<style>
  .stage {
    position: relative;
    height: clamp(560px, 78vh, 720px);
    border-radius: 22px;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse at 50% 30%, var(--accent-soft), transparent 60%), var(--bg-elev);
    overflow: hidden;
    isolation: isolate;
  }

  .viewport {
    position: absolute;
    inset: 0;
  }

  .viewport :global(canvas:not([data-geo-plan])) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    touch-action: none;
  }

  .stage.is-ready .viewport :global(canvas:not([data-geo-plan])) {
    animation: scene-in 1.2s var(--ease);
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      filter: blur(8px);
    }
  }

  .status {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    font-size: 14px;
    color: var(--muted);
  }

  .status:empty {
    display: none;
  }

  /* 三维标签 */
  .pins {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .pins :global(.geo-pin) {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(6px);
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .pins :global(.pin-station b) {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--code-var);
    color: #241a05;
    font: 700 10px var(--font-sans);
  }

  .pins :global(.pin-park) {
    border-color: rgb(110 160 100 / 0.5);
    color: var(--muted);
  }

  .pins :global(.pin-hit) {
    border-color: var(--accent);
    color: var(--ink);
    box-shadow: 0 0 18px var(--glow);
  }

  .pins :global(.pin-hit span),
  .pins :global(.pin-hit b) {
    font-weight: 400;
  }

  .pins :global(.pin-hit span) {
    color: var(--accent-ink);
    font-family: var(--font-mono);
  }

  .pins :global(.pin-selected) {
    border-color: var(--ink);
    color: var(--ink);
  }

  /* 浮层面板 */
  .panel {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: var(--shadow);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .panel-queries {
    top: 16px;
    left: 16px;
    bottom: 76px;
    width: 280px;
  }

  .panel-info {
    top: 16px;
    right: 16px;
    width: 292px;
    max-height: calc(100% - 32px - 186px - 12px);
  }

  .panel-label {
    font-size: 12px;
    color: var(--faint);
  }

  .queries {
    display: grid;
    gap: 6px;
  }

  .queries button {
    display: flex;
    gap: 12px;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid transparent;
    text-align: left;
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }

  .queries button:hover {
    background: var(--surface-2);
  }

  .queries button[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .q-index {
    font: 500 12px/1.9 var(--font-mono);
    color: var(--faint);
  }

  [aria-pressed='true'] .q-index {
    color: var(--accent-ink);
  }

  .q-body {
    display: grid;
    gap: 2px;
  }

  .q-title {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.5;
  }

  .q-feature {
    font: 11.5px var(--font-mono);
    color: var(--faint);
  }

  /* 结果列表 */
  .results {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .results :global(.results-head) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .results :global(.results-head span) {
    padding: 0 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .results :global(.results-head code) {
    margin-left: auto;
    font-size: 11px;
    padding: 0;
    background: none;
    color: var(--faint);
  }

  .results :global(.results-sub) {
    margin: 12px 0 6px;
    font-size: 12px;
    color: var(--faint);
  }

  .results :global(ul) {
    display: grid;
    gap: 2px;
  }

  .results :global(.result) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 14px;
    text-align: left;
    transition: background-color 0.2s;
  }

  .results :global(button.result:hover),
  .results :global(.result.is-selected) {
    background: var(--surface-2);
  }

  .results :global(.result-detail) {
    font: 12px var(--font-mono);
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .results :global(.is-miss .result-name) {
    color: var(--muted);
  }

  .results :global(.is-miss .result-detail) {
    color: var(--faint);
  }

  /* 建筑详情 */
  .panel-info :global(.info-kind) {
    font-size: 12px;
    color: var(--accent-ink);
  }

  .panel-info :global(.info-title) {
    margin-top: -6px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .panel-info :global(.info-text),
  .panel-info :global(.info-meta) {
    margin-top: -4px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .panel-info :global(.info-label) {
    font-size: 12px;
    color: var(--faint);
  }

  .panel-info :global(.info-row) {
    display: grid;
    margin-top: -6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font: 12px/1.6 var(--font-mono);
    overflow: hidden;
  }

  .panel-info :global(.info-row div) {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
  }

  .panel-info :global(.info-row div + div) {
    border-top: 1px solid var(--line);
  }

  .panel-info :global(.info-row dt) {
    padding: 5px 10px;
    color: var(--faint);
    background: var(--surface-2);
  }

  .panel-info :global(.info-row dd) {
    padding: 5px 10px;
    font-family: var(--font-mono), var(--font-sans);
    overflow-wrap: anywhere;
  }

  .panel-info :global(.code) {
    margin: -6px 0 0;
    padding: 12px;
    border-radius: 10px;
    background: var(--code-bg);
    color: var(--code-ink);
    font: 11.5px/1.7 var(--font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .panel-info :global(.info-close) {
    align-self: flex-start;
    font-size: 13px;
    color: var(--accent-ink);
  }

  .layer-legend {
    display: grid;
    gap: 10px;
  }

  .layer-legend li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 2px 10px;
    align-items: baseline;
  }

  .layer-legend b {
    font-size: 14px;
  }

  .layer-legend span {
    grid-column: 2;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    transform: translateY(1px);
  }

  .swatch-onto {
    background: var(--code-var);
  }

  .swatch-graph {
    background: var(--ink);
  }

  .swatch-map {
    background: var(--accent);
  }

  .swatch-data {
    background: var(--line-strong);
    border: 1px solid var(--muted);
  }

  /* 查询执行步骤（分层视图） */
  .steps {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 2;
    translate: -50% 0;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 12.5px;
    white-space: nowrap;
  }

  .geo[data-view='city'] .steps,
  .geo[data-view='layers'] [data-geo-rotate] {
    display: none;
  }

  .steps li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 6px;
    border-radius: 999px;
    color: var(--faint);
    transition:
      color 0.3s,
      background-color 0.3s;
  }

  .steps li span {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid currentColor;
    font: 600 10px var(--font-mono);
  }

  .steps li:global(.is-done) {
    color: var(--muted);
  }

  .steps li:global(.is-current) {
    color: var(--ink);
    background: var(--accent-soft);
  }

  .steps li:global(.is-current) span {
    border-color: var(--accent);
    background: var(--accent);
    color: #041015;
  }

  /* 分层视图中的标签 */
  .pins :global(.pin-layer) {
    translate: calc(-100% - 10px) -50%;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    padding: 4px 10px;
    border-radius: 8px;
    text-align: right;
  }

  .pins :global(.pin-layer b) {
    font-size: 12.5px;
    color: var(--ink);
  }

  .pins :global(.pin-layer span) {
    font-size: 11px;
    color: var(--faint);
  }

  .pins :global(.pin-layer-onto) {
    border-color: color-mix(in srgb, var(--code-var) 60%, transparent);
  }

  .pins :global(.pin-layer-map) {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .pins :global(.pin-class) {
    border-color: color-mix(in srgb, var(--code-var) 70%, transparent);
    font: 12px var(--font-mono);
    color: var(--ink);
    transition: opacity 0.4s;
  }

  .pins :global(.pin-class.is-dim) {
    opacity: 0.35;
  }

  .pins :global(.pin-entity) {
    border-color: var(--accent);
    box-shadow: 0 0 16px var(--glow);
  }

  .pins :global(.pin-entity b) {
    font-weight: 500;
    color: var(--ink);
  }

  .pins :global(.pin-entity span),
  .pins :global(.pin-selected-graph span) {
    font: 11px var(--font-mono);
    color: var(--accent-ink);
  }

  .pins :global(.pin-gate) {
    padding: 1px 8px;
    font-size: 11px;
    color: var(--muted);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .pins :global(.pin-gate code) {
    padding: 0;
    background: none;
    font-size: 11px;
  }

  /* 平面图与工具栏 */
  .planbox {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    width: 248px;
    margin: 0;
    padding: 10px 10px 8px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .planbox canvas {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    cursor: crosshair;
  }

  .planbox figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-size: 11px;
    color: var(--faint);
  }

  .toolbar {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .toolbar button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(10px);
    font-size: 13px;
    color: var(--ink-2);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .toolbar button:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .toolbar [data-geo-rotate][aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent-ink);
  }

  [data-geo-mode][aria-pressed='true'] :global(.when-day),
  [data-geo-mode][aria-pressed='false'] :global(.when-night),
  [data-geo-fullscreen][aria-pressed='true'] :global(.when-normal),
  [data-geo-fullscreen][aria-pressed='false'] :global(.when-full) {
    display: none;
  }

  /* 全屏：优先使用原生全屏；不支持时以固定定位铺满窗口 */
  .stage.is-fullscreen {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    border: 0;
    border-radius: 0;
  }

  .stage.is-pseudo-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  :global(html.geo-locked) {
    overflow: hidden;
  }

  .hint {
    margin-left: 6px;
    font-size: 12px;
    color: var(--faint);
  }

  /* 无 WebGL：平面图放大替代三维场景，场景工具栏不再适用 */
  .stage.is-fallback .toolbar {
    display: none;
  }

  .stage.is-fallback .planbox {
    left: 332px;
    right: 352px;
    top: 16px;
    bottom: 76px;
    width: auto;
    display: grid;
    place-items: center;
  }

  .stage.is-fallback .planbox canvas {
    width: auto;
    height: 100%;
    max-width: 100%;
  }

  .stage.is-fallback .status {
    top: auto;
    bottom: 28px;
    left: auto;
    right: 352px;
    translate: none;
  }

  @media (max-width: 1080px) {
    .steps {
      top: 10px;
      font-size: 11px;
    }

    .steps li {
      padding: 2px 8px 2px 3px;
      gap: 4px;
    }

    .steps li span {
      width: 15px;
      height: 15px;
      font-size: 9px;
    }

    .stage {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 0 0 12px;
    }

    .viewport {
      position: relative;
      height: min(64vh, 480px);
      flex: none;
    }

    .panel {
      position: static;
      width: auto;
      max-height: none;
      margin-inline: 12px;
      box-shadow: none;
    }

    .panel-queries {
      order: 1;
    }

    .panel-info {
      order: 2;
    }

    .queries {
      grid-auto-flow: column;
      grid-auto-columns: minmax(200px, 1fr);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .planbox {
      width: 156px;
      padding: 6px;
    }

    .planbox figcaption,
    .hint {
      display: none;
    }

    .toolbar {
      left: 12px;
      bottom: 12px;
      right: 180px;
    }

    .toolbar span:not(.hint) {
      display: none;
    }

    .toolbar button {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .stage.is-fallback .planbox {
      inset: 12px;
      width: auto;
    }

    /* 窄屏下层名标签放在平面角的内侧，避免溢出画面 */
    .pins :global(.pin-layer) {
      translate: 6px -50%;
      align-items: flex-start;
      text-align: left;
    }

    .pins :global(.pin-layer span) {
      display: none;
    }

    /* 窄屏全屏：场景铺满，查询以横向卡片浮于顶部，其余面板隐藏 */
    .stage.is-fullscreen {
      display: block;
      padding: 0;
    }

    .stage.is-fullscreen .viewport {
      position: absolute;
      inset: 0;
      height: auto;
    }

    .stage.is-fullscreen .panel-info,
    .stage.is-fullscreen .results,
    .stage.is-fullscreen .panel-label {
      display: none;
    }

    .stage.is-fullscreen .panel-queries {
      position: absolute;
      top: 48px;
      left: 0;
      right: 0;
      z-index: 2;
      margin: 0;
      padding: 0 12px;
      border: 0;
      background: none;
