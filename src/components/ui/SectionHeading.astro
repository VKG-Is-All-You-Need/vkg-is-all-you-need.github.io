---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  id?: string;
  link?: { href: string; label: string };
}

const { title, description, id, link } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {link && (
    <a class="heading-link" href={link.href}>
      {link.label}
      <Icon name="arrow-right" size={16} />
    </a>
  )}
</header>

<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 48px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  p {
    max-width: 40em;
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
  }

  .heading-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    font-size: 15px;
    color: var(--accent-ink);
  }

  .heading-link :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .heading-link:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 720px) {
    .section-heading {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
