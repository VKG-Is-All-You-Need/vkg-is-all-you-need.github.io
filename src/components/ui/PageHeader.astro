---
import { art as artSrc } from '../../lib/art';

interface Props {
  title: string;
  description: string;
  label?: string;
  /** 右侧的单色线稿插图，public/art/ 中的素材名。 */
  art?: string;
}

const { title, description, label, art } = Astro.props;
---

<section class="page-header">
  <div class="backdrop dot-grid" aria-hidden="true"></div>
  <div class="container">
    {art && <span class="art line-art" style={`--src:url(${artSrc(art)})`} aria-hidden="true" />}
    {label && <p class="label">{label}</p>}
    <h1>{title}</h1>
    <p class="description">{description}</p>
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(56px, 8vw, 96px));
    padding-bottom: clamp(40px, 6vw, 64px);
    overflow: hidden;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 60% 90% at 70% 0%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 90% at 70% 0%, #000 20%, transparent 75%);
  }

  .backdrop::after {
    content: '';
    position: absolute;
    top: -40%;
    right: 5%;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent);
    opacity: 0.35;
    filter: blur(40px);
  }

  .container {
    position: relative;
  }

  .art {
    position: absolute;
    right: 0;
    bottom: -12px;
    width: clamp(240px, 30vw, 420px);
    height: clamp(180px, 21vw, 290px);
    -webkit-mask-position: right bottom;
    mask-position: right bottom;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 14px;
    color: var(--accent-ink);
  }

  .label::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--glow);
  }

  h1 {
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1.08;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .description {
    max-width: 40em;
    margin-top: 20px;
    font-size: clamp(16px, 1.6vw, 18px);
    color: var(--muted);
  }

  /* 文字为插图让出右侧空间 */
  @media (min-width: 861px) {
    .art ~ h1,
    .art ~ .description {
      max-width: min(40em, calc(100% - clamp(240px, 30vw, 420px) + 40px));
    }
  }

  @media (max-width: 860px) {
    .art {
      display: none;
    }
  }
</style>
