---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 1200 970"
  width={size}
  height={Math.round((size * 970) / 1200)}
  aria-hidden="true"
  {...rest}
>
  <g transform="translate(-30 -140)" fill="currentColor">
    <path d="M49 167H203L341 378 527 167H675L317 567Z"></path>
    <path d="M451 421 553 309V520L764 327H928L671 557 782 663 694 748 553 612V922L451 826Z"></path>
    <path
      d="M782 663H1070L1168 762H879L813 825V933L868 986H1070V906H899V816H1203V989L1101 1086H791L694 989V748Z"
    ></path>
    <path class="logo-accent" d="M451 421 553 309V430L451 529ZM694 748 782 663 828 710 694 835Z"
    ></path>
  </g>
</svg>

<style>
  .logo-accent {
    fill: var(--accent);
  }
</style>
