---
import Icon from './Icon.astro';
import { site } from '../../data/site';
import { langOf, localize } from '../../i18n';
import { art } from '../../lib/art';

const lang = langOf(Astro.url.pathname);
const t = {
  zh: {
    title: '参与贡献',
    text: '补充资源、修正描述或报告失效链接，均可通过 issue 或 pull request 提交。',
    issue: '提交 issue',
    guide: '贡献说明',
  },
  en: {
    title: 'Contributing',
    text: 'New resources, corrections and broken links can be submitted as an issue or a pull request.',
    issue: 'Open an issue',
    guide: 'Contribution guide',
  },
}[lang];
---

<section class="section" aria-labelledby="contribute-title">
  <div class="container">
    <div class="banner" data-reveal>
      <div class="banner-glow" aria-hidden="true"></div>
      <img
        class="banner-art"
        src={art('contribute')}
        width="280"
        height="194"
        alt=""
        loading="lazy"
      />
      <div class="banner-copy">
        <span class="banner-icon">
          <Icon name="git-pull" size={22} />
        </span>
        <h2 id="contribute-title">{t.title}</h2>
        <p>{t.text}</p>
      </div>
      <div class="banner-actions">
        <a class="btn btn-primary" href={site.links.issues}>
          {t.issue} <Icon name="arrow-right" />
        </a>
        <a class="btn" href={localize('/about/#contribute', lang)}>
          {t.guide}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
  }

  .banner-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(600px circle at 100% 0%, var(--accent-soft), transparent 60%),
      radial-gradient(
        500px circle at 0% 100%,
        color-mix(in srgb, var(--code-var) 8%, transparent),
        transparent 60%
      );
  }

  .banner-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(90deg, transparent 40%, #000);
    -webkit-mask-image: linear-gradient(90deg, transparent 40%, #000);
  }

  .banner-art {
    position: absolute;
    top: clamp(16px, 3vw, 32px);
    right: clamp(16px, 5vw, 64px);
    z-index: -1;
    width: clamp(110px, 18vw, 220px);
    height: auto;
    filter: drop-shadow(0 18px 30px var(--glow));
    animation: cb-float 6s var(--ease) infinite;
  }

  @keyframes cb-float {
    50% {
      transform: translateY(-8px);
    }
  }

  .banner-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--accent-ink);
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  p {
    max-width: 32em;
    margin-top: 10px;
    color: var(--muted);
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
